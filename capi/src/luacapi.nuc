; The Lua 5.5 C API for Nucleus, one to one: the stock headers, and a macro for
; each of their function-like macros. Macros, not functions, so that a library
; built on this exports nothing of it and two such libraries can share a process.
;
; lua.h, lauxlib.h, lualib.h: Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(import-use "lua.h")
(import-use "lauxlib.h")
(import-use "lualib.h")

; --- lua.h ---

(defmacro lua_upvalueindex (i) `(- LUA_REGISTRYINDEX ~i))
(defmacro lua_call (L n r) `(lua_callk ~L ~n ~r 0 null))
(defmacro lua_pcall (L n r f) `(lua_pcallk ~L ~n ~r ~f 0 null))
(defmacro lua_yield (L n) `(lua_yieldk ~L ~n 0 null))
(defmacro lua_getextraspace (L)
  `(unsafe/ptr+ (unsafe/cast ptr:i8 ~L) (- 0 LUA_EXTRASPACE)))
(defmacro lua_tonumber (L i) `(lua_tonumberx ~L ~i null))
(defmacro lua_tointeger (L i) `(lua_tointegerx ~L ~i null))
(defmacro lua_pop (L n) `(lua_settop ~L (- (- 0 ~n) 1)))
(defmacro lua_newtable (L) `(lua_createtable ~L 0 0))
(defmacro lua_register (L n f)
  `(do (lua_pushcfunction ~L ~f) (lua_setglobal ~L ~n)))
(defmacro lua_pushcfunction (L f) `(lua_pushcclosure ~L ~f 0))
(defmacro lua_isfunction (L n) `(= (lua_type ~L ~n) LUA_TFUNCTION))
(defmacro lua_istable (L n) `(= (lua_type ~L ~n) LUA_TTABLE))
(defmacro lua_islightuserdata (L n) `(= (lua_type ~L ~n) LUA_TLIGHTUSERDATA))
(defmacro lua_isnil (L n) `(= (lua_type ~L ~n) LUA_TNIL))
(defmacro lua_isboolean (L n) `(= (lua_type ~L ~n) LUA_TBOOLEAN))
(defmacro lua_isthread (L n) `(= (lua_type ~L ~n) LUA_TTHREAD))
(defmacro lua_isnone (L n) `(= (lua_type ~L ~n) LUA_TNONE))
(defmacro lua_isnoneornil (L n) `(<= (lua_type ~L ~n) 0))
(defmacro lua_pushliteral (L s) `(lua_pushstring ~L ~s))
(defmacro lua_pushglobaltable (L)
  `(lua_rawgeti ~L LUA_REGISTRYINDEX LUA_RIDX_GLOBALS))
(defmacro lua_tostring (L i) `(lua_tolstring ~L ~i null))
(defmacro lua_insert (L idx) `(lua_rotate ~L ~idx 1))
(defmacro lua_remove (L idx) `(do (lua_rotate ~L ~idx -1) (lua_pop ~L 1)))
(defmacro lua_replace (L idx) `(do (lua_copy ~L -1 ~idx) (lua_pop ~L 1)))
(defmacro lua_newuserdata (L s) `(lua_newuserdatauv ~L ~s 1))
(defmacro lua_getuservalue (L idx) `(lua_getiuservalue ~L ~idx 1))
(defmacro lua_setuservalue (L idx) `(lua_setiuservalue ~L ~idx 1))
(defmacro lua_resetthread (L) `(lua_closethread ~L null))

; --- lauxlib.h ---

(defmacro luaL_checkversion (L)
  `(luaL_checkversion_ ~L LUA_VERSION_NUM LUAL_NUMSIZES))
(defmacro luaL_loadfile (L f) `(luaL_loadfilex ~L ~f null))
(defmacro luaL_newlibtable (L n) `(lua_createtable ~L 0 ~n))
(defmacro luaL_argcheck (L cond arg extramsg)
  `(when (not ~cond) (luaL_argerror ~L ~arg ~extramsg)))
(defmacro luaL_argexpected (L cond arg tname)
  `(when (not ~cond) (luaL_typeerror ~L ~arg ~tname)))
(defmacro luaL_checkstring (L n) `(luaL_checklstring ~L ~n null))
(defmacro luaL_optstring (L n d) `(luaL_optlstring ~L ~n ~d null))
(defmacro luaL_typename (L i) `(lua_typename ~L (lua_type ~L ~i)))
(defmacro luaL_dofile (L fn)
  `(or (!= (luaL_loadfile ~L ~fn) 0) (!= (lua_pcall ~L 0 LUA_MULTRET 0) 0)))
(defmacro luaL_dostring (L s)
  `(or (!= (luaL_loadstring ~L ~s) 0) (!= (lua_pcall ~L 0 LUA_MULTRET 0) 0)))
(defmacro luaL_getmetatable (L n) `(lua_getfield ~L LUA_REGISTRYINDEX ~n))
(defmacro luaL_opt (L f n d) `(if (lua_isnoneornil ~L ~n) ~d (~f ~L ~n)))
(defmacro luaL_loadbuffer (L s sz n) `(luaL_loadbufferx ~L ~s ~sz ~n null))
(defmacro luaL_pushfail (L) `(lua_pushnil ~L))
(defmacro luaL_bufflen (bf) `(~bf 'n))
(defmacro luaL_buffaddr (bf) `(~bf 'b))
(defmacro luaL_addchar (B c)
  `(do (when (>= (~B 'n) (~B 'size)) (luaL_prepbuffsize ~B 1))
       (set! (aref (~B 'b) (~B 'n)) ~c)
       (set! (~B 'n) (+ (~B 'n) 1))))
(defmacro luaL_addsize (B s) `(set! (~B 'n) (+ (~B 'n) ~s)))
(defmacro luaL_buffsub (B s) `(set! (~B 'n) (- (~B 'n) ~s)))
(defmacro luaL_prepbuffer (B) `(luaL_prepbuffsize ~B LUAL_BUFFERSIZE))
(defmacro luaL_intop (op v1 v2)
  `(as lua_Integer (~op (as lua_Unsigned ~v1) (as lua_Unsigned ~v2))))

; --- lualib.h ---

(defmacro luaL_openlibs (L) `(luaL_openselectedlibs ~L (bit-not 0) 0))
