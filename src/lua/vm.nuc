      (savepc ci)
      (when (!= (TESTARG_k i) 0)  ; open upvalues, maybe
        (set! ((ci 'u2) 'nres) n)
        (when (< (as ptr ((L 'top) 'p)) (as ptr ((ci 'top) 'p)))
          (set! ((L 'top) 'p) ((ci 'top) 'p)))
        (func-close L base CLOSEKTOP 1)
        (updatetrap ci)
        (when (!= trap 0)  ; updatestack
          (updatebase ci)
          (set! ra (RA i))))
      (when (!= nparams1 0)  ; a vararg function
        (set! ((ci 'func) 'p) (p+ ((ci 'func) 'p) (- (+ (((ci 'u) 'l) 'nextraargs) nparams1)))))
