      (let (n:i32 (do-pretailcall L ci ra b delta))
        (when (< n 0)  ; a Lua function: run it
          (goto startfunc))
        (set! ((ci 'func) 'p) (p+ ((ci 'func) 'p) (- delta)))  ; a C function: restore 'func'
        (do-poscall L ci n)  ; and finish the caller
        (updatetrap ci)  ; do-poscall can change hooks
        (goto ret)))
    (label OP_RETURN)
