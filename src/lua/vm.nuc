    (vmbreak)
    (label OP_NOT)
    (if (l_isfalse (vRB i))
      (setbtvalue (vRA i))
      (setbfvalue (vRA i)))
    (vmbreak)
    (label OP_LEN)
    (Protect (vm-objlen L (RA i) (vRB i)))
    (vmbreak)
    (label OP_CONCAT)
    (let (ra:StkId (RA i)
          n:i32 (as i32 (GETARG_B i)))  ; how many to concatenate
