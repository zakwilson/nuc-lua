    (vmbreak)
    (label OP_CLOSURE)
    (let (ra:StkId (RA i)
          p:(ptr Proto) (deref (p+ ((cl 'p) 'p) (GETARG_Bx i))))
      (halfProtect (pushclosure L p (as (ptr (ptr UpVal)) (cl 'upvals)) base ra))
      (checkGC L (p+ ra 1)))
    (vmbreak)
    (label OP_VARARG)
    (let (n:i32 (- (as i32 (GETARG_C i)) 1)  ; the results wanted, -1 for all
          vatab:i32 (if (!= (GETARG_k i) 0) (as i32 (GETARG_B i)) -1))
      (Protect (tm-getvarargs L ci (RA i) n vatab)))
    (vmbreak)
    (label OP_GETVARG)
    (tm-getvararg ci (RA i) (vRC i))
    (vmbreak)
    (label OP_ERRNNIL)
    (when (not (ttisnil (vRA i)))
      (halfProtect (debug-errnnil L cl (as i32 (GETARG_Bx i)))))
    (vmbreak)
    (label OP_VARARGPREP)
    (ProtectNT (tm-adjustvarargs L ci (cl 'p)))
