          (savepc ci)
          (do-poscall L ci 0)  ; no hurry
          (set! trap 1))
      (let (nres:i32 (get_nresults (ci 'callstatus)))  ; do-poscall, here
        (set! (L 'ci) (ci 'previous))  ; back to the caller
        (set! ((L 'top) 'p) (p+ base -1))
        (while (> nres 0)  ; every result is nil
          (setnilvalue (s2v ((L 'top) 'p)))
          (set! ((L 'top) 'p) (p+ ((L 'top) 'p) 1))
          (set! nres (- nres 1)))))
    (goto ret)
    (label OP_RETURN1)
    (if (!= (L 'hookmask) 0)
      (do (set! ((L 'top) 'p) (p+ (RA i) 1))
          (savepc ci)
          (do-poscall L ci 1)  ; no hurry
          (set! trap 1))
      (let (nres:i32 (get_nresults (ci 'callstatus)))
        (set! (L 'ci) (ci 'previous))
        (if (= nres 0)
          (set! ((L 'top) 'p) (p+ base -1))  ; no results wanted
          (do (setobjs2s L (p+ base -1) (RA i))  ; this one at least
              (set! ((L 'top) 'p) base)
              (while (> nres 1)  ; the missing ones are nil
                (setnilvalue (s2v ((L 'top) 'p)))
                (set! ((L 'top) 'p) (p+ ((L 'top) 'p) 1))
                (set! nres (- nres 1)))))))
    (label ret)  ; a Lua function returns
    (when (!= (bit-and (ci 'callstatus) CIST_FRESH) 0)
      (return))  ; this frame ends
    (set! ci (ci 'previous))
    (goto returning)  ; the caller goes on in this frame
    (label OP_FORLOOP)
    (let (ra:StkId (RA i))
      (if (ttisinteger (s2v (p+ ra 1)))  ; an integer loop
        (let (count:lua_Unsigned (l_castS2U (ivalue (s2v ra))))
          (when (> count 0)  ; more to go
            (let (step:lua_Integer (ivalue (s2v (p+ ra 1)))
                  idx:lua_Integer (ivalue (s2v (p+ ra 2))))  ; the control variable
              (chgivalue (s2v ra) (l_castU2S (- count 1)))
              (chgivalue (s2v (p+ ra 2)) (intop + idx step))
              (set! pc (p+ pc (- (GETARG_Bx i)))))))  ; back
        (when (floatforloop L ra)
          (set! pc (p+ pc (- (GETARG_Bx i))))))
      (updatetrap ci))  ; a signal can break the loop
    (vmbreak)
    (label OP_FORPREP)
    (let (ra:StkId (RA i))
      (savestate L ci)  ; for errors
      (when (forprep L ra)
