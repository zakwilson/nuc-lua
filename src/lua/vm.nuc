      (do-hookcall L ci)
      (set! (L 'oldpc) 1))  ; the next opcode is on a "new" line
    (updatebase ci)  ; the adjustment moved the base
    (vmbreak)
    (label OP_EXTRAARG)
    (vmbreak)))
