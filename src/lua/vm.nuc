    (vmbreak)
    (label OP_TAILCALL)
    (let (ra:StkId (RA i)
          b:i32 (as i32 (GETARG_B i))  ; arguments + 1 (the function)
          nparams1:i32 (as i32 (GETARG_C i))
          ; the virtual 'func' minus the real one, for a vararg function
          delta:i32 (if (!= nparams1 0) (+ (((ci 'u) 'l) 'nextraargs) nparams1) 0))
      (if (!= b 0)
