    (label OP_CLOSE)
    (Protect (func-close L (RA i) LUA_OK 1))
    (vmbreak)
    (label OP_TBC)
    (halfProtect (func-newtbcupval L (RA i)))  ; a new to-be-closed upvalue
    (vmbreak)
    (label OP_JMP)
    (dojump ci i 0)
    (vmbreak)
    (label OP_EQ)
    (let (ra:StkId (RA i)
          rb:(ptr TValue) (vRB i)
          condition:bool false)
      (Protect (set! condition (!= (vm-equalobj L (s2v ra) rb) 0)))
      (docondjump))
    (vmbreak)
    (label OP_LT)
    (op_order L l_lti ltnum lessthanothers)
    (vmbreak)
    (label OP_LE)
    (op_order L l_lei lenum lessequalothers)
    (vmbreak)
    (label OP_EQK)
    ; basic types have no '__eq': raw equality will do
    (let (condition:bool (!= (vm-equalobj null (vRA i) (KB i)) 0))
      (docondjump))
    (vmbreak)
    (label OP_EQI)
    (let (ra:StkId (RA i)
          im:i32 (GETARG_sB i)
          condition:bool (cond (ttisinteger (s2v ra)) (= (ivalue (s2v ra)) (as lua_Integer im))
                          (ttisfloat (s2v ra)) (= (fltvalue (s2v ra)) (cast_num im))
                          true false))  ; no other type equals a number
      (docondjump))
    (vmbreak)
    (label OP_LTI)
    (op_orderI L l_lti numlt 0 TM_LT)
    (vmbreak)
    (label OP_LEI)
    (op_orderI L l_lei numle 0 TM_LE)
    (vmbreak)
    (label OP_GTI)
    (op_orderI L l_gti numgt 1 TM_LT)
    (vmbreak)
    (label OP_GEI)
    (op_orderI L l_gei numge 1 TM_LE)
    (vmbreak)
    (label OP_TEST)
    (let (condition:bool (not (l_isfalse (vRA i))))
      (docondjump))
    (vmbreak)
    (label OP_TESTSET)
    (let (rb:(ptr TValue) (vRB i))
