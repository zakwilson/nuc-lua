    (vmbreak)
    (label OP_TFORPREP)
    ; 'ra' has the iterator, 'ra+1' the state, 'ra+2' the control variable's
    ; start, 'ra+3' the closing variable: swap the last two and mark it
    (let (ra:StkId (RA i)
          temp:(ptr TValue) (alloca TValue))
      (setobj L temp (s2v (p+ ra 3)))
      (setobjs2s L (p+ ra 3) (p+ ra 2))
      (setobj2s L (p+ ra 2) temp)
      (halfProtect (func-newtbcupval L (p+ ra 2)))  ; unless it is nil
      (set! pc (p+ pc (GETARG_Bx i)))  ; the loop's end
      (set! i (deref pc))  ; the OP_TFORCALL
      (set! pc (p+ pc 1)))
    (goto l_tforcall)
    (label OP_TFORCALL)
    (label l_tforcall)
    ; the call starts at 'ra+3', keeping the first three values; its first
    ; result is the control variable's next value
    (let (ra:StkId (RA i))
      (setobjs2s L (p+ ra 5) (p+ ra 3))  ; the control variable
      (setobjs2s L (p+ ra 4) (p+ ra 1))  ; the state
      (setobjs2s L (p+ ra 3) ra)  ; the function
      (set! ((L 'top) 'p) (p+ ra 6))
      (ProtectNT (do-call L (p+ ra 3) (as i32 (GETARG_C i))))
      (when (!= trap 0)  ; updatestack: the stack may have moved
        (updatebase ci))
      (set! i (deref pc))  ; the OP_TFORLOOP
      (set! pc (p+ pc 1)))
    (goto l_tforloop)
    (label OP_TFORLOOP)
    (label l_tforloop)
    (when (not (ttisnil (s2v (p+ (RA i) 3))))  ; go on
      (set! pc (p+ pc (- (GETARG_Bx i)))))
    (vmbreak)
    (label OP_SETLIST)
    (let (ra:StkId (RA i)
          n:ui32 (cast_uint (GETARG_vB i))
          last:ui32 (cast_uint (GETARG_vC i))
          h:(ptr Table) (hvalue (s2v ra)))
      (if (= n 0)
        (set! n (- (cast_uint (stack-diff ((L 'top) 'p) ra)) 1))  ; up to the top
        (set! ((L 'top) 'p) ((ci 'top) 'p)))  ; right for an emergency collection
      (set! last (+ last n))
      (when (!= (TESTARG_k i) 0)
        (set! last (+ last (* (cast_uint (GETARG_Ax (deref pc))) (+ MAXARG_vC 1))))
        (set! pc (p+ pc 1)))
      (when (> last (h 'asize))  ; room needed, at once
        (table-resizearray L h last))
      (while (> n 0)
        (let (val:(ptr TValue) (s2v (p+ ra n)))
          (obj2arr h (- last 1) val)
          (set! last (- last 1))
          (gc-barrierback L (obj2gco h) val))
