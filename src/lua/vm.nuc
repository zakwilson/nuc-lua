        (set! pc (p+ pc 1))
        (do (setobj2s L (RA i) rb)
            (donextjump ci))))
    (vmbreak)
    (label OP_CALL)
    (let (ra:StkId (RA i)
          b:i32 (as i32 (GETARG_B i))
          nresults:i32 (- (as i32 (GETARG_C i)) 1))
