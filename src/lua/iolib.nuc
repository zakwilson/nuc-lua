; The I/O library, in its POSIX configuration (LUA_USE_LINUX).
;
; liolib.c: Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(ns lua.iolib)
(set-ir-prefix "")
(import-use luacapi)
(import-use lua.util)
(import-use "ctype.h")
(import-use "errno.h")
(import-use "locale.h")
(import-use "stdio.h")
(import-use "stdlib.h")
(import-use "string.h")
(import-use "sys/types.h")

; Whether 'mode' matches '[rwa]%+?b*'.
(defn- l_checkmode (mode:CStr):bool
  (let (m:(ptr i8) (bytes mode))
    (when (or (= (deref m) 0) (= (strchr "rwa" (as i32 (deref m))) null))
      (return false))
    (set! m (unsafe/ptr+ m 1))
    (when (= (deref m) (ch \+))
      (set! m (unsafe/ptr+ m 1)))
    (return (= (strspn (cstr m) "b") (strlen (cstr m))))))

; popen accepts only "r" or "w".
(defn- l_checkmodep (mode:CStr):bool
  (let (m:(ptr i8) (bytes mode))
    (return (and (or (= (aref m 0) (ch \r)) (= (aref m 0) (ch \w))) (= (aref m 1) 0)))))

(defconst IO_INPUT "_IO_input")
(defconst IO_OUTPUT "_IO_output")
(defconst IOPREF_LEN 4)  ; the length of the "_IO_" prefix

(defmacro- tolstream (L) `(unsafe/cast &luaL_Stream (luaL_checkudata ~L 1 LUA_FILEHANDLE)))
(defmacro- isclosed (p) `(= (~p 'closef) null))

(defn- io_type (L:(ptr lua_State)):i32
  (luaL_checkany L 1)
  (let (p:(ptr luaL_Stream) (unsafe/cast (ptr luaL_Stream) (luaL_testudata L 1 LUA_FILEHANDLE)))
    (cond
      (= p null) (luaL_pushfail L)  ; not a file
      (isclosed p) (lua_pushliteral L "closed file")
      true (lua_pushliteral L "file"))
    (return 1)))

(defn- f_tostring (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L))
    (if (isclosed p)
      (lua_pushliteral L "file (closed)")
      (lua_pushfstring L "file (%p)" (p 'f)))
    (return 1)))

(defn- tofile (L:(ptr lua_State)):(ptr FILE)
  (let (p:&luaL_Stream (tolstream L))
    (when (isclosed p)
      (luaL_error L "attempt to use a closed file"))
    (return (p 'f))))

; A new handle starts closed, so that a memory error opening the file leaves it
; consistent.
(defn- newprefile (L:(ptr lua_State)):&luaL_Stream
  (let (p:&luaL_Stream (unsafe/cast &luaL_Stream (lua_newuserdatauv L (sizeof luaL_Stream) 0)))
    (set! (p 'closef) null)  ; closed
    (luaL_setmetatable L LUA_FILEHANDLE)
    (return p)))

; Calls the handle's own close function.
(defn- aux_close (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L)
        cf:lua_CFunction (p 'closef))
    (set! (p 'closef) null)  ; closed
    (return (cf L))))

(defn- f_close (L:(ptr lua_State)):i32
  (tofile L)  ; an open file?
  (return (aux_close L)))

(defn- io_close (L:(ptr lua_State)):i32
  (when (lua_isnone L 1)  ; no argument: the default output
    (lua_getfield L LUA_REGISTRYINDEX IO_OUTPUT))
  (return (f_close L)))

(defn- f_gc (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L))
    (when (and (not (isclosed p)) (!= (p 'f) null))
      (aux_close L))  ; not closed or half-opened files
    (return 0)))

; The close function of a regular file.
(defn- io_fclose (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L))
    (set-errno 0)
    (return (luaL_fileresult L (if (= (fclose (p 'f)) 0) 1 0) (as CStr null)))))

(defn- newfile (L:(ptr lua_State)):&luaL_Stream
  (let (p:&luaL_Stream (newprefile L))
    (set! (p 'f) null)
    (set! (p 'closef) io_fclose)
    (return p)))

(defn- opencheck (L:(ptr lua_State) fname:CStr mode:CStr):void
  (let (p:&luaL_Stream (newfile L))
    (set! (p 'f) (fopen fname mode))
    (when (= (p 'f) null)
      (luaL_error L "cannot open file '%s' (%s)" fname (strerror (errno))))))

(defn- io_open (L:(ptr lua_State)):i32
  (let (filename:CStr (luaL_checkstring L 1)
        mode:CStr (luaL_optstring L 2 "r")
        p:&luaL_Stream (newfile L))
    (luaL_argcheck L (l_checkmode mode) 2 "invalid mode")
    (set-errno 0)
    (set! (p 'f) (fopen filename mode))
    (return (if (= (p 'f) null) (luaL_fileresult L 0 filename) 1))))

; The close function of a popen file.
(defn- io_pclose (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L))
    (set-errno 0)
    (return (luaL_execresult L (pclose (p 'f))))))

(defn- io_popen (L:(ptr lua_State)):i32
  (let (filename:CStr (luaL_checkstring L 1)
        mode:CStr (luaL_optstring L 2 "r")
        p:&luaL_Stream (newprefile L))
    (luaL_argcheck L (l_checkmodep mode) 2 "invalid mode")
    (set-errno 0)
    (fflush null)
    (set! (p 'f) (popen filename mode))
    (set! (p 'closef) io_pclose)
    (return (if (= (p 'f) null) (luaL_fileresult L 0 filename) 1))))

(defn- io_tmpfile (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (newfile L))
    (set-errno 0)
    (set! (p 'f) (tmpfile))
    (return (if (= (p 'f) null) (luaL_fileresult L 0 (as CStr null)) 1))))

(defn- getiofile (L:(ptr lua_State) findex:CStr):(ptr FILE)
  (lua_getfield L LUA_REGISTRYINDEX findex)
  (let (p:&luaL_Stream (unsafe/cast &luaL_Stream (lua_touserdata L -1)))
    (when (isclosed p)
      (luaL_error L "default %s file is closed" (unsafe/ptr+ (bytes findex) IOPREF_LEN)))
    (return (p 'f))))

(defn- g_iofile (L:(ptr lua_State) f:CStr mode:CStr):i32
  (when (not (lua_isnoneornil L 1))
    (let (filename:CStr (lua_tostring L 1))
      (if (!= (as ptr filename) null)
        (opencheck L filename mode)
        (do (tofile L)  ; a valid handle?
            (lua_pushvalue L 1)))
      (lua_setfield L LUA_REGISTRYINDEX f)))
  (lua_getfield L LUA_REGISTRYINDEX f)  ; the current one
  (return 1))

(defn- io_input (L:(ptr lua_State)):i32
  (return (g_iofile L IO_INPUT "r")))

(defn- io_output (L:(ptr lua_State)):i32
  (return (g_iofile L IO_OUTPUT "w")))

; The most arguments 'lines' takes: it + 3 must fit a closure's upvalues.
(defconst MAXARGLINE 250)

; The iterator for 'lines': io_readline closed over the file, how many formats,
; whether to close the file at the end, and the formats.
(defn- aux_lines (L:(ptr lua_State) toclose:i32):void
  (let (n:i32 (- (lua_gettop L) 1))  ; how many formats
    (luaL_argcheck L (<= n MAXARGLINE) (+ MAXARGLINE 2) "too many arguments")
    (lua_pushvalue L 1)  ; the file
    (lua_pushinteger L (as lua_Integer n))
    (lua_pushboolean L toclose)
    (lua_rotate L 2 3)  ; the three, below the formats
    (lua_pushcclosure L io_readline (+ 3 n))))

(defn- f_lines (L:(ptr lua_State)):i32
  (tofile L)  ; a valid handle?
  (aux_lines L 0)
  (return 1))

; io.lines: the iterator, and when it opened the file, the file as the
; to-be-closed fourth result.
(defn- io_lines (L:(ptr lua_State)):i32
  (let (toclose:i32 0)
    (when (lua_isnone L 1) (lua_pushnil L))  ; at least one argument
    (if (lua_isnil L 1)  ; no file name: the default input
      (do (lua_getfield L LUA_REGISTRYINDEX IO_INPUT)
          (lua_replace L 1)
          (tofile L)
          (set! toclose 0))
      (let (filename:CStr (luaL_checkstring L 1))
        (opencheck L filename "r")
        (lua_replace L 1)
        (set! toclose 1)))
    (aux_lines L toclose)
    (when (!= toclose 0)
      (lua_pushnil L)  ; the state
      (lua_pushnil L)  ; the control
      (lua_pushvalue L 1)  ; the file, to be closed
      (return 4))
    (return 1)))

; ---- Reading ----

(defconst L_MAXLENNUM 200)  ; the longest numeral

; What read_number keeps: the file, the lookahead, and the numeral so far.
(defstruct RN
  f:(ptr FILE)
  c:i32
  n:i32
  buff:(array i8 201))  ; L_MAXLENNUM + 1 for the '\0'

; Keeps the current character, if there's room, and reads the next.
(defn- nextc (rn:&RN):bool
  (when (>= (rn 'n) L_MAXLENNUM)  ; too long
    (set! (aref (rn 'buff) 0) 0)  ; invalidate the numeral
    (return false))
  (set! (aref (rn 'buff) (rn 'n)) (cast_char (rn 'c)))
  (set! (rn 'n) (+ (rn 'n) 1))
  (set! (rn 'c) (getc_unlocked (rn 'f)))
  (return true))

; Accepts the current character if it's one of the two in 'set'.
(defn- test2 (rn:&RN set:(ptr i8)):bool
  (if (or (= (rn 'c) (as i32 (aref set 0))) (= (rn 'c) (as i32 (aref set 1))))
    (return (nextc rn))
    (return false)))

(defn- readdigits (rn:&RN hex:bool):i32
  (let (count:i32 0)
    (while (and (!= (if hex (isxdigit (rn 'c)) (isdigit (rn 'c))) 0) (nextc rn))
      (inc! count))
    (return count)))

; Reads the longest prefix that could be a numeral, then lets
; lua_stringtonumber decide whether it is one.
(defn- read_number (L:(ptr lua_State) f:(ptr FILE)):i32
  (let (rn:&RN (alloca RN)
        count:i32 0
        hex:bool false
        decp:(ptr i8) (alloca i8 2))
    (set! (rn 'f) f)
    (set! (rn 'n) 0)
    (set! (aref decp 0) (aref (bytes ((localeconv) 'decimal_point)) 0))  ; the locale's
    (set! (aref decp 1) (ch \.))  ; and always a dot
    (flockfile f)
    (set! (rn 'c) (getc_unlocked f))
    (while (!= (isspace (rn 'c)) 0)  ; skip spaces
      (set! (rn 'c) (getc_unlocked f)))
    (test2 rn (bytes "-+"))  ; a sign
    (when (test2 rn (bytes "00"))
      (if (test2 rn (bytes "xX"))
        (set! hex true)
        (set! count 1)))  ; the 0 is a digit
    (set! count (+ count (readdigits rn hex)))  ; the integral part
    (when (test2 rn decp)
      (set! count (+ count (readdigits rn hex))))  ; the fraction
    (when (and (> count 0) (test2 rn (bytes (if hex "pP" "eE"))))  ; an exponent
      (test2 rn (bytes "-+"))
      (readdigits rn false))
    (ungetc (rn 'c) f)  ; the lookahead
    (funlockfile f)
    (set! (aref (rn 'buff) (rn 'n)) 0)
    (when (!= (lua_stringtonumber L (cstr (rn 'buff))) 0)
      (return 1))
    (lua_pushnil L)  ; a "result" for the caller to drop
    (return 0)))

(defn- test_eof (L:(ptr lua_State) f:(ptr FILE)):i32
  (let (c:i32 (getc f))
    (ungetc c f)  ; a no-op at EOF
    (lua_pushliteral L "")
    (return (if (!= c EOF) 1 0))))

(defn- read_line (L:(ptr lua_State) f:(ptr FILE) chop:bool):i32
  (let (b:&luaL_Buffer (alloca luaL_Buffer)
        c:i32 0)
    (luaL_buffinit L b)
    (while true  ; a long line takes several chunks
      (let (buff:(ptr i8) (bytes (luaL_prepbuffer b))
            i:ui32 0)
        (flockfile f)  ; no memory error can happen inside the lock
        (while (< i LUAL_BUFFERSIZE)
          (set! c (getc_unlocked f))
          (when (or (= c EOF) (= c (ch \newline))) (break))
          (set! (aref buff i) (cast_char c))
          (inc! i))
        (funlockfile f)
        (luaL_addsize b (as usize i)))
      (when (or (= c EOF) (= c (ch \newline))) (break)))
    (when (and (not chop) (= c (ch \newline)))  ; keep the newline
      (luaL_addchar b (ch \newline)))
    (luaL_pushresult b)
    ; success if anything was read, a newline included
    (return (if (or (= c (ch \newline)) (> (lua_rawlen L -1) 0)) 1 0))))

(defn- read_all (L:(ptr lua_State) f:(ptr FILE)):void
  (let (b:&luaL_Buffer (alloca luaL_Buffer)
        nr:usize LUAL_BUFFERSIZE)
    (luaL_buffinit L b)
    (while (= nr LUAL_BUFFERSIZE)  ; in chunks
      (let (p:CStr (luaL_prepbuffer b))
        (set! nr (fread (bytes p) 1 LUAL_BUFFERSIZE f))
        (luaL_addsize b nr)))
    (luaL_pushresult b)))

(defn- read_chars (L:(ptr lua_State) f:(ptr FILE) n:usize):i32
  (let (b:&luaL_Buffer (alloca luaL_Buffer))
    (luaL_buffinit L b)
    (let (p:CStr (luaL_prepbuffsize b n)  ; room for all of it
          nr:usize (fread (bytes p) 1 n f))
      (luaL_addsize b nr)
      (luaL_pushresult b)
      (return (if (> nr 0) 1 0)))))

(defn- g_read (L:(ptr lua_State) f:(ptr FILE) first:i32):i32
  (let (nargs:i32 (- (lua_gettop L) 1)
        n:i32 first
        success:i32 1)
    (clearerr f)
    (set-errno 0)
    (if (= nargs 0)  ; no formats: a line
      (do (set! success (read_line L f true))
          (set! n (+ first 1)))  ; one result
      (do
        ; room for every result and for the buffer
        (luaL_checkstack L (+ nargs LUA_MINSTACK) "too many arguments")
        (while (and (> nargs 0) (!= success 0))
          (dec! nargs)
          (if (= (lua_type L n) LUA_TNUMBER)
            (let (l:usize (cast_sizet (luaL_checkinteger L n)))
              (set! success (if (= l 0) (test_eof L f) (read_chars L f l))))
            (let (p:(ptr i8) (bytes (luaL_checkstring L n)))
              (when (= (deref p) (ch \*))  ; an optional '*', from older versions
                (set! p (unsafe/ptr+ p 1)))
              (let (k:i8 (deref p))
                (cond
                  (= k (ch \n)) (set! success (read_number L f))
                  (= k (ch \l)) (set! success (read_line L f true))
                  (= k (ch \L)) (set! success (read_line L f false))  ; with the newline
                  (= k (ch \a)) (do (read_all L f) (set! success 1))
                  true (return (luaL_argerror L n "invalid format"))))))
          (inc! n))))
    (when (!= (ferror f) 0)
      (return (luaL_fileresult L 0 (as CStr null))))
    (when (= success 0)
      (lua_pop L 1)  ; the last result
      (luaL_pushfail L))
    (return (- n first))))

(defn- io_read (L:(ptr lua_State)):i32
  (return (g_read L (getiofile L IO_INPUT) 1)))

(defn- f_read (L:(ptr lua_State)):i32
  (return (g_read L (tofile L) 2)))

; The iterator 'lines' returns.
(defn- io_readline (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (unsafe/cast &luaL_Stream (lua_touserdata L (lua_upvalueindex 1)))
        n:i32 (cast_int (lua_tointeger L (lua_upvalueindex 2))))
    (when (isclosed p)
      (return (luaL_error L "file is already closed")))
    (lua_settop L 1)
    (luaL_checkstack L n "too many arguments")
    (for (i:i32 1) (<= i n) (inc! i)  ; the formats, for g_read
      (lua_pushvalue L (lua_upvalueindex (+ 3 i))))
    (set! n (g_read L (p 'f) 2))  ; how many results
    (when (!= (lua_toboolean L (- 0 n)) 0)  ; read something?
      (return n))
    ; EOF or an error
    (when (> n 1)  ; the second result is the message
      (return (luaL_error L "%s" (lua_tostring L (+ (- 0 n) 1)))))
    (when (!= (lua_toboolean L (lua_upvalueindex 3)) 0)  ; opened by 'lines'?
      (lua_settop L 0)
      (lua_pushvalue L (lua_upvalueindex 1))
      (aux_close L))
    (return 0)))

; ---- Writing ----

(defn- g_write (L:(ptr lua_State) f:(ptr FILE) arg:i32):i32
  (let (nargs:i32 (- (lua_gettop L) arg)
        totalbytes:usize 0
        buff:(ptr i8) (alloca i8 LUA_N2SBUFFSZ))
    (set-errno 0)
    (while (> nargs 0)
      (dec! nargs)
      (let (len:usize (as usize (lua_numbertocstring L arg buff))  ; a number?
            s:CStr (cstr buff))
        (if (> len 0)
          (dec! len)  ; without the '\0'
          (set! s (luaL_checklstring L arg &len)))  ; then a string
        (let (numbytes:usize (fwrite s 1 len f))
          (set! totalbytes (+ totalbytes numbytes))
          (when (< numbytes len)  ; a write error
            (let (n:i32 (luaL_fileresult L 0 (as CStr null)))
              (lua_pushinteger L (l_castU2S totalbytes))
              (return (+ n 1))))))  ; fail, message, code and the count
      (inc! arg))
    (return 1)))  ; the file handle is on the top

(defn- io_write (L:(ptr lua_State)):i32
  (return (g_write L (getiofile L IO_OUTPUT) 1)))

(defn- f_write (L:(ptr lua_State)):i32
  (let (f:(ptr FILE) (tofile L))
    (lua_pushvalue L 1)  ; the file, the result
    (return (g_write L f 2))))

(defvar- seek-mode:(array i32 3) (array i32 SEEK_SET SEEK_CUR SEEK_END))
(defvar- seek-modenames:(array CStr 4) (array CStr "set" "cur" "end" (as CStr null)))

; off_t is 64 bits here, so every lua_Integer offset fits.
(defn- f_seek (L:(ptr lua_State)):i32
  (let (f:(ptr FILE) (tofile L)
        op:i32 (luaL_checkoption L 2 "cur" seek-modenames)
        offset:off_t (luaL_optinteger L 3 0))
    (set-errno 0)
    (when (!= (fseeko f offset (aref seek-mode op)) 0)
      (return (luaL_fileresult L 0 (as CStr null))))
    (lua_pushinteger L (ftello f))
    (return 1)))

; glibc's values: a `_`-prefixed macro isn't imported, public or not (ISSUE-024).
(defvar- vbuf-mode:(array i32 3) (array i32 2 0 1))  ; _IONBF _IOFBF _IOLBF
(defvar- vbuf-modenames:(array CStr 4) (array CStr "no" "full" "line" (as CStr null)))

(defn- f_setvbuf (L:(ptr lua_State)):i32
  (let (f:(ptr FILE) (tofile L)
        op:i32 (luaL_checkoption L 2 (as CStr null) vbuf-modenames)
        sz:lua_Integer (luaL_optinteger L 3 LUAL_BUFFERSIZE))
    (set-errno 0)
    (let (res:i32 (setvbuf f null (aref vbuf-mode op) (cast_sizet sz)))
      (return (luaL_fileresult L (if (= res 0) 1 0) (as CStr null))))))

(defn- aux_flush (L:(ptr lua_State) f:(ptr FILE)):i32
  (set-errno 0)
  (return (luaL_fileresult L (if (= (fflush f) 0) 1 0) (as CStr null))))

(defn- f_flush (L:(ptr lua_State)):i32
  (return (aux_flush L (tofile L))))

(defn- io_flush (L:(ptr lua_State)):i32
  (return (aux_flush L (getiofile L IO_OUTPUT))))

; The metatable of file handles, whose __index holds the methods.
(defn- createmeta (L:(ptr lua_State)):void
  (luaL_newmetatable L LUA_FILEHANDLE)
  (lua-setfuncs L 0
    ("__index" null) ("__gc" f_gc) ("__close" f_gc) ("__tostring" f_tostring))
  (lua_createtable L 0 7)  ; the methods
  (lua-setfuncs L 0
    ("read" f_read) ("write" f_write) ("lines" f_lines) ("flush" f_flush)
    ("seek" f_seek) ("close" f_close) ("setvbuf" f_setvbuf))
  (lua_setfield L -2 "__index")
  (lua_pop L 1))  ; the metatable

; The close function of stdin, stdout and stderr, which stay open.
(defn- io_noclose (L:(ptr lua_State)):i32
  (let (p:&luaL_Stream (tolstream L))
    (set! (p 'closef) io_noclose)  ; still open
    (luaL_pushfail L)
    (lua_pushliteral L "cannot close standard file")
    (return 2)))

(defn- createstdfile (L:(ptr lua_State) f:(ptr FILE) k:CStr fname:CStr):void
  (let (p:&luaL_Stream (newprefile L))
    (set! (p 'f) f)
    (set! (p 'closef) io_noclose)
    (when (!= (as ptr k) null)
      (lua_pushvalue L -1)
      (lua_setfield L LUA_REGISTRYINDEX k))  ; a default file
    (lua_setfield L -2 fname)))

(defn luaopen_io (L:(ptr lua_State)):i32
  (lua-newlib L
    ("close" io_close) ("flush" io_flush) ("input" io_input) ("lines" io_lines)
    ("open" io_open) ("output" io_output) ("popen" io_popen) ("read" io_read)
    ("tmpfile" io_tmpfile) ("type" io_type) ("write" io_write))
  (createmeta L)
  (createstdfile L stdin IO_INPUT "stdin")
  (createstdfile L stdout IO_OUTPUT "stdout")
  (createstdfile L stderr (as CStr null) "stderr")
  (return 1))
