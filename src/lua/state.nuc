; The global state and threads: creating, resetting and closing them, and
; their lists of CallInfos.
;
; lstate.c: Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(ns lua.state)
(set-ir-prefix "")
(import-use "lstate.h")
(import-use "lapi.h")
(import-use "ldebug.h")
(import-use "ldo.h")
(import-use "lfunc.h")
(import-use "lgc.h")
(import-use "llex.h")
(import-use "lmem.h")
(import-use "lstring.h")
(import-use "ltable.h")
(import-use "ltm.h")
(import-use "string.h")
(import-use lua.util)
(import-use lua.core)
(import-use lua.object)
(import-use lua.func)
(import-use lua.gc)
(import-use lua.lex)
(import-use lua.tm)
(import-use lua.string)
(import-use lua.table)
(import-use lua.debug)
(import-use lua.do)
(import-use lua.mem)

(defconst BASIC_STACK_SIZE 40)  ; 2*LUA_MINSTACK
(defconst EXTRA_STACK 5)
(defconst GCSTPGC 2)            ; the collector stopped itself
(defconst GCSpause 8)
(defconst KGC_INC 0)

; The LX holding a thread: the extra space sits just before it.
(defmacro fromstate (L) `(unsafe/cast (ptr LX) (p+ (bytes ~L) (- (offsetof LX l)))))
(defmacro setgcparam (g p v) `(set! (aref (~g 'gcparams) ~p) (obj-codeparam ~v)))

; Sets GCdebt, keeping GCtotalbytes - GCdebt (the bytes really allocated)
; invariant without overflowing GCtotalbytes.
(defn state-setdebt (g:(ptr global_State) debt0:l_mem):void
  (let (tb:l_mem (gettotalbytes g)
        debt:l_mem (if (> debt0 (- MAX_LMEM tb)) (- MAX_LMEM tb) debt0))  ; GCtotalbytes == MAX_LMEM
    (set! (g 'GCtotalbytes) (+ tb debt))
    (set! (g 'GCdebt) debt)))

(defn state-extend-ci (L:(ptr lua_State) err:i32):(ptr CallInfo)
  (let (ci:(ptr CallInfo) (mem-reallocvector L null 0 1 CallInfo))
    (when (= (as ptr ci) null)  ; the allocation failed?
      (when (!= err 0) (mem-error L))
      (return null))  ; else only report it
    (set! (ci 'next) ((L 'ci) 'next))
    (set! (ci 'previous) (L 'ci))
    (set! ((L 'ci) 'next) ci)
    (when (!= (as ptr (ci 'next)) null)
      (set! ((ci 'next) 'previous) ci))
    (set! (((ci 'u) 'l) 'trap) 0)
    (set! (L 'nci) (+ (L 'nci) 1))
    (return ci)))

; Frees every CallInfo the thread isn't using.
(defn- free-ci (L:(ptr lua_State)):void
  (let (ci:(ptr CallInfo) (L 'ci)
        next:(ptr CallInfo) (ci 'next))
    (set! (ci 'next) null)
    (while (!= (as ptr next) null)
      (set! ci next)
      (set! next (ci 'next))
      (mem-free L ci CallInfo)
      (set! (L 'nci) (- (L 'nci) 1)))))

; Frees half the CallInfos the thread isn't using, keeping the first.
(defn state-shrink-ci (L:(ptr lua_State)):void
  (let (ci:(ptr CallInfo) ((L 'ci) 'next))  ; the first free one
    (when (= (as ptr ci) null) (return))
    (while (!= (as ptr (ci 'next)) null)  ; two extra elements?
      (let (next:(ptr CallInfo) (ci 'next)
            next2:(ptr CallInfo) (next 'next))
        (set! (ci 'next) next2)  ; remove 'next' from the list
        (set! (L 'nci) (- (L 'nci) 1))
        (mem-free L next CallInfo)
        (when (= (as ptr next2) null) (break))
        (set! (next2 'previous) ci)
        (set! ci next2)))))

; At getCcalls(L) >= LUAI_MAXCCALLS: an overflow error when equal; when larger
; but not by much, nothing, so the overflow's own handling can run.
(defn state-checkcstack (L:(ptr lua_State)):void
  (cond (= (getCcalls L) LUAI_MAXCCALLS) (debug-runerror L "C stack overflow")
        (>= (getCcalls L) (* (/ LUAI_MAXCCALLS 10) 11)) (do-errerr L)))  ; an error while handling one

(defn state-inc-cstack (L:(ptr lua_State)):void
  (set! (L 'nCcalls) (+ (L 'nCcalls) 1))
  (when (>= (getCcalls L) LUAI_MAXCCALLS)
    (state-checkcstack L)))

(defn- reset-ci (L:(ptr lua_State)):void
  (let (ci:(ptr CallInfo) (ref (L 'base_ci)))
    (set! (L 'ci) ci)
    (set! ((ci 'func) 'p) ((L 'stack) 'p))
    (setnilvalue2s ((ci 'func) 'p))  ; the basic ci's 'function' entry
    (set! ((ci 'top) 'p) (p+ ((ci 'func) 'p) (+ 1 LUA_MINSTACK)))
    (set! (((ci 'u) 'c) 'k) null)
    (set! (ci 'callstatus) CIST_C)
    (set! (L 'status) LUA_OK)
    (set! (L 'errfunc) 0)))  ; unwinding the stack may drop the error function

(defn- stack-init (L1:(ptr lua_State) L:(ptr lua_State)):void
  (set! ((L1 'stack) 'p) (mem-newvector L (+ BASIC_STACK_SIZE EXTRA_STACK) StackValue))
  (set! ((L1 'tbclist) 'p) ((L1 'stack) 'p))
  (for (i:i32 0) (< i (+ BASIC_STACK_SIZE EXTRA_STACK)) (inc! i)
    (setnilvalue2s (p+ ((L1 'stack) 'p) i)))
  (set! ((L1 'stack_last) 'p) (p+ ((L1 'stack) 'p) BASIC_STACK_SIZE))
  (reset-ci L1)
  (set! ((L1 'top) 'p) (p+ ((L1 'stack) 'p) 1)))  ; past the 'function' entry

(defn- freestack (L:(ptr lua_State)):void
  (when (= (as ptr ((L 'stack) 'p)) null)
    (return))  ; the stack isn't built yet
  (set! (L 'ci) (ref (L 'base_ci)))  ; free the whole ci list
  (free-ci L)
  (mem-freearray L ((L 'stack) 'p) (+ (stacksize L) EXTRA_STACK) StackValue))

; The registry, with registry[1] = false, the main thread and the globals.
(defn- init-registry (L:(ptr lua_State) g:(ptr global_State)):void
  (let (aux:(ptr TValue) (alloca TValue)
        registry:(ptr Table) (table-new L))
    (sethvalue L (ref (g 'l_registry)) registry)
    (table-resize L registry LUA_RIDX_LAST 0)
    (setbfvalue aux)
    (table-setint L registry 1 aux)
    (setthvalue L aux L)
    (table-setint L registry LUA_RIDX_MAINTHREAD aux)
    (sethvalue L aux (table-new L))
    (table-setint L registry LUA_RIDX_GLOBALS aux)))

; The parts of the state that may fail to allocate.
(defn- f-luaopen (L:(ptr lua_State) ud:ptr):void
  (let (g:(ptr global_State) (G L))
    (stack-init L L)
    (init-registry L g)
    (string-init L)
    (tm-init L)
    (lex-init L)
    (set! (g 'gcstp) 0)  ; allow the collector
    (setnilvalue (ref (g 'nilvalue)))))  ; the state is complete

; Consistent values for a thread, allocating nothing, so nothing can fail.
(defn- preinit-thread (L:(ptr lua_State) g:(ptr global_State)):void
  (set! (L 'l_G) g)
  (set! ((L 'stack) 'p) null)
  (set! (L 'ci) null)
  (set! (L 'nci) 0)
  (set! (L 'twups) L)  ; no upvalues
  (set! (L 'nCcalls) 0)
  (set! (L 'errorJmp) null)
  (set! (L 'hook) null)
  (set! (L 'hookmask) 0)
  (set! (L 'basehookcount) 0)
  (set! (L 'allowhook) 1)
  (resethookcount L)
  (set! (L 'openupval) null)
  (set! (L 'status) LUA_OK)
  (set! (L 'errfunc) 0)
  (set! (L 'oldpc) 0)
  (set! ((L 'base_ci) 'previous) null)
  (set! ((L 'base_ci) 'next) null))

(defn state-threadsize (L:(ptr lua_State)):lu_mem
  (let (sz:lu_mem (+ (cast_sizet (sizeof LX)) (* (as lu_mem (cast_uint (L 'nci))) (cast_sizet (sizeof CallInfo)))))
    (when (!= (as ptr ((L 'stack) 'p)) null)
      (set! sz (+ sz (* (as lu_mem (cast_uint (+ (stacksize L) EXTRA_STACK))) (cast_sizet (sizeof StackValue))))))
    (return sz)))

(defn- close-state (L:(ptr lua_State)):void
  (let (g:(ptr global_State) (G L))
    (if (not (completestate g))
      (gc-freeallobjects L)  ; partly built: just collect its objects
      (do (reset-ci L)
          (do-closeprotected L 1 LUA_OK)  ; close every upvalue
          (set! ((L 'top) 'p) (p+ ((L 'stack) 'p) 1))  ; an empty stack, for the finalizers
          (gc-freeallobjects L)))
    (mem-freearray L ((g 'strt) 'hash) ((g 'strt) 'size) (ptr TString))
    (freestack L)
    ((g 'frealloc) (g 'ud) (as ptr g) (cast_sizet (sizeof global_State)) 0)))  ; the main block

(defn lua_newthread (L:(ptr lua_State)):(ptr lua_State)
  (let (g:(ptr global_State) (G L))
    (gc-check L)
    (let (o:(ptr GCObject) (gc-newobjdt L LUA_TTHREAD (cast_sizet (sizeof LX)) (offsetof LX l))
          L1:(ptr lua_State) (gco2th o))
      (setthvalue L (s2v ((L 'top) 'p)) L1)  ; anchored on L's stack
      (set! ((L 'top) 'p) (p+ ((L 'top) 'p) 1))
      (preinit-thread L1 g)
      (set! (L1 'hookmask) (L 'hookmask))
      (set! (L1 'basehookcount) (L 'basehookcount))
      (set! (L1 'hook) (L 'hook))
      (resethookcount L1)
      (memcpy (lua_getextraspace L1) (lua_getextraspace (mainthread g)) LUA_EXTRASPACE)
      (stack-init L1 L)
      (return L1))))

(defn state-freethread (L:(ptr lua_State) L1:(ptr lua_State)):void
  (let (l:(ptr LX) (fromstate L1))
    (func-closeupval L1 ((L1 'stack) 'p))  ; close every upvalue
    (freestack L1)
    (mem-free L l LX)))

(defn state-resetthread (L:(ptr lua_State) status0:TStatus):TStatus
  (reset-ci L)
  (let (status:TStatus (do-closeprotected L 1 (if (= status0 LUA_YIELD) LUA_OK status0)))
    (if (!= status LUA_OK)  ; errors?
      (do-seterrorobj L status (p+ ((L 'stack) 'p) 1))
      (set! ((L 'top) 'p) (p+ ((L 'stack) 'p) 1)))
    (do-reallocstack L (cast_int (stack-diff (((L 'ci) 'top) 'p) ((L 'stack) 'p))) 0)
    (return status)))

(defn lua_closethread (L:(ptr lua_State) from:(ptr lua_State)):i32
  (set! (L 'nCcalls) (if (!= (as ptr from) null) (getCcalls from) 0))
  (let (status:TStatus (state-resetthread L (L 'status)))
    (when (= L from)  ; closing itself?
      (do-throwbaselevel L status))
    (return (as i32 status))))

(defn lua_newstate (f:lua_Alloc ud:ptr seed:ui32):(ptr lua_State)
  (let (g:(ptr global_State) (unsafe/cast (ptr global_State)
                                          (f ud null LUA_TTHREAD (cast_sizet (sizeof global_State)))))
    (when (= (as ptr g) null) (return null))
    (let (L:(ptr lua_State) (mainthread g))
      (set! (L 'tt) LUA_VTHREAD)
      (set! (g 'currentwhite) 8)  ; bitmask(WHITE0BIT)
      (set! (L 'marked) (cast_uchar (bit-and (g 'currentwhite) WHITEBITS)))  ; gc-white
      (preinit-thread L g)
      (set! (g 'allgc) (obj2gco L))  ; the only object yet
      (set! (L 'next) null)
      (incnny L)  ; the main thread never yields
      (set! (g 'frealloc) f)
      (set! (g 'ud) ud)
      (set! (g 'warnf) null)
      (set! (g 'ud_warn) null)
      (set! (g 'seed) seed)
      (set! (g 'gcstp) GCSTPGC)  ; no collection while the state is built
      (set! ((g 'strt) 'size) 0)
      (set! ((g 'strt) 'nuse) 0)
      (set! ((g 'strt) 'hash) null)
      (setnilvalue (ref (g 'l_registry)))
      (set! (g 'panic) null)
      (set! (g 'gcstate) GCSpause)
      (set! (g 'gckind) KGC_INC)
      (set! (g 'gcstopem) 0)
      (set! (g 'gcemergency) 0)
      (set! (g 'finobj) null) (set! (g 'tobefnz) null) (set! (g 'fixedgc) null)
      (set! (g 'firstold1) null) (set! (g 'survival) null)
      (set! (g 'old1) null) (set! (g 'reallyold) null)
      (set! (g 'finobjsur) null) (set! (g 'finobjold1) null) (set! (g 'finobjrold) null)
      (set! (g 'sweepgc) null)
      (set! (g 'gray) null) (set! (g 'grayagain) null)
      (set! (g 'weak) null) (set! (g 'ephemeron) null) (set! (g 'allweak) null)
      (set! (g 'twups) null)
      (set! (g 'GCtotalbytes) (unsafe/cast l_mem (sizeof global_State)))
      (set! (g 'GCmarked) 0)
      (set! (g 'GCdebt) 0)
      (setivalue (ref (g 'nilvalue)) 0)  ; the state isn't built yet
      (setgcparam g LUA_GCPPAUSE 250)  ; LUAI_GCPAUSE
      (setgcparam g LUA_GCPSTEPMUL 200)  ; LUAI_GCMUL
      (setgcparam g LUA_GCPSTEPSIZE (cast_uint (* 200 (sizeof Table))))  ; LUAI_GCSTEPSIZE
      (setgcparam g LUA_GCPMINORMUL 20)  ; LUAI_GENMINORMUL
      (setgcparam g LUA_GCPMINORMAJOR 70)  ; LUAI_MINORMAJOR
      (setgcparam g LUA_GCPMAJORMINOR 50)  ; LUAI_MAJORMINOR
      (for (i:i32 0) (< i LUA_NUMTYPES) (inc! i)
        (set! (aref (g 'mt) i) null))
      (when (!= (do-rawrunprotected L f-luaopen null) LUA_OK)
        (close-state L)  ; an allocation failed: free the partial state
        (return null))
      (return L))))

(defn lua_close (L:(ptr lua_State)):void
  (close-state (mainthread (G L))))  ; only the main thread can be closed

(defn state-warning (L:(ptr lua_State) msg:CStr tocont:i32):void
  (let (wf:lua_WarnFunction ((G L) 'warnf))
    (when (!= (unsafe/cast ptr wf) null)
      (wf ((G L) 'ud_warn) msg tocont))))

; The warning "error in WHERE (MSG)" from the error object on the top.
(defn state-warnerror (L:(ptr lua_State) where:CStr):void
  (let (errobj:(ptr TValue) (s2v (p+ ((L 'top) 'p) -1))
        msg:CStr (if (ttisstring errobj) (cstr (getstr (tsvalue errobj))) (cstr "error object is not a string")))
    (state-warning L "error in " 1)
    (state-warning L where 1)
    (state-warning L " (" 1)
    (state-warning L msg 1)
    (state-warning L ")" 0)))
