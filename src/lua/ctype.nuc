; Character classes for the lexer, as a table rather than <ctype.h>: Lua wants
; them independent of the locale.
;
; lctype.c: Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(ns lua.ctype)
(set-ir-prefix "")

; lctype.h's tests, over an int that is EOZ or an unsigned char. The masks are
; 1 << ALPHABIT (0), DIGITBIT (1), PRINTBIT (2), SPACEBIT (3), XDIGITBIT (4).
(defmacro testprop (c mask) `(!= (bit-and (aref ctype-table (+ ~c 1)) ~mask) 0))
(defmacro lislalpha (c) `(testprop ~c 1))
(defmacro lislalnum (c) `(testprop ~c 3))
(defmacro lisdigit (c) `(testprop ~c 2))
(defmacro lisspace (c) `(testprop ~c 8))
(defmacro lisprint (c) `(testprop ~c 4))
(defmacro lisxdigit (c) `(testprop ~c 16))
; Lowercase for a letter only: 'A' ^ 'a' is the case bit, 32.
(defmacro ltolower (c) `(bit-or ~c 32))

; Indexed by a character plus one, so that EOZ (-1) has an entry. The bits are
; lctype.h's ALPHABIT 0, DIGITBIT 1, PRINTBIT 2, SPACEBIT 3 and XDIGITBIT 4; the
; non-ASCII bytes are 0 (NONA, as LUA_UCID is off).
(defvar ctype-table:(array ui8 257)
 (array ui8
  0x00  ; EOZ
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x08 0x08 0x08 0x08 0x08 0x00 0x00  ; 0.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; 1.
  0x0c 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04 0x04  ; 2.
  0x16 0x16 0x16 0x16 0x16 0x16 0x16 0x16 0x16 0x16 0x04 0x04 0x04 0x04 0x04 0x04  ; 3.
  0x04 0x15 0x15 0x15 0x15 0x15 0x15 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05  ; 4.
  0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x04 0x04 0x04 0x04 0x05  ; 5.
  0x04 0x15 0x15 0x15 0x15 0x15 0x15 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05  ; 6.
  0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x05 0x04 0x04 0x04 0x04 0x00  ; 7.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; 8.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; 9.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; a.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; b.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; c.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; d.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; e.
  0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00  ; f.
  ))
