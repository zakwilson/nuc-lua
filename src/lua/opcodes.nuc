; Opcodes of the Lua virtual machine: the instruction format and the opcode
; table. One row set gives every per-opcode table, so they can't fall out of step.
;
; lopcodes.c: Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(ns lua.opcodes)
(set-ir-prefix "")
(import-use "lopcodes.h")
(import-use lua.util)
(import-ct nucleus.node)
(import-ct nucleus.intern)

; ---- the instruction format ----
; 'n' one bits at position 'p'.
(defmacro MASK1 (n p) `(bit-shl (bit-xor (bit-shl (as Instruction 0xFFFFFFFF) (as ui32 ~n)) 0xFFFFFFFF) (as ui32 ~p)))
(defmacro MASK0 (n p) `(bit-xor (MASK1 ~n ~p) 0xFFFFFFFF))
(defmacro cast_Inst (x) `(unsafe/cast Instruction ~x))

(defmacro GET_OPCODE (i) `(cast_int (bit-and (bit-shr ~i (as ui32 POS_OP)) (MASK1 SIZE_OP 0))))
(defmacro getarg (i pos size) `(cast_int (bit-and (bit-shr ~i (as ui32 ~pos)) (MASK1 ~size 0))))
; A whole new instruction: set! won't take a macro as its place (ISSUE-020).
(defmacro setarg (i v pos size)
  `(set! ~i (bit-or (bit-and ~i (MASK0 ~size ~pos))
                    (bit-and (bit-shl (cast_Inst ~v) (as ui32 ~pos)) (MASK1 ~size ~pos)))))
(defmacro SET_OPCODE (i o) `(setarg ~i ~o POS_OP SIZE_OP))

(defmacro GETARG_A (i) `(getarg ~i POS_A SIZE_A))
(defmacro SETARG_A (i v) `(setarg ~i ~v POS_A SIZE_A))
(defmacro GETARG_B (i) `(getarg ~i POS_B SIZE_B))
(defmacro GETARG_vB (i) `(getarg ~i POS_vB SIZE_vB))
(defmacro GETARG_sB (i) `(sC2int (GETARG_B ~i)))
(defmacro SETARG_B (i v) `(setarg ~i ~v POS_B SIZE_B))
(defmacro SETARG_vB (i v) `(setarg ~i ~v POS_vB SIZE_vB))
(defmacro GETARG_C (i) `(getarg ~i POS_C SIZE_C))
(defmacro GETARG_vC (i) `(getarg ~i POS_vC SIZE_vC))
(defmacro GETARG_sC (i) `(sC2int (GETARG_C ~i)))
(defmacro SETARG_C (i v) `(setarg ~i ~v POS_C SIZE_C))
(defmacro SETARG_vC (i v) `(setarg ~i ~v POS_vC SIZE_vC))
(defmacro TESTARG_k (i) `(cast_int (bit-and ~i (bit-shl (as ui32 1) (as ui32 POS_k)))))
(defmacro GETARG_k (i) `(getarg ~i POS_k 1))
(defmacro SETARG_k (i v) `(setarg ~i ~v POS_k 1))
(defmacro GETARG_Bx (i) `(getarg ~i POS_Bx SIZE_Bx))
(defmacro SETARG_Bx (i v) `(setarg ~i ~v POS_Bx SIZE_Bx))
(defmacro GETARG_Ax (i) `(getarg ~i POS_Ax SIZE_Ax))
(defmacro SETARG_Ax (i v) `(setarg ~i ~v POS_Ax SIZE_Ax))
(defmacro GETARG_sBx (i) `(- (getarg ~i POS_Bx SIZE_Bx) OFFSET_sBx))
(defmacro SETARG_sBx (i b) `(SETARG_Bx ~i (cast_uint (+ ~b OFFSET_sBx))))
(defmacro GETARG_sJ (i) `(- (getarg ~i POS_sJ SIZE_sJ) OFFSET_sJ))
(defmacro SETARG_sJ (i j) `(setarg ~i (cast_uint (+ ~j OFFSET_sJ)) POS_sJ SIZE_sJ))
(defmacro int2sC (i) `(+ ~i OFFSET_sC))
(defmacro sC2int (i) `(- ~i OFFSET_sC))

(defmacro CREATE_ABCk (o a b c k)
  `(bit-or (bit-shl (cast_Inst ~o) (as ui32 POS_OP)) (bit-shl (cast_Inst ~a) (as ui32 POS_A))
           (bit-shl (cast_Inst ~b) (as ui32 POS_B)) (bit-shl (cast_Inst ~c) (as ui32 POS_C))
           (bit-shl (cast_Inst ~k) (as ui32 POS_k))))
(defmacro CREATE_vABCk (o a b c k)
  `(bit-or (bit-shl (cast_Inst ~o) (as ui32 POS_OP)) (bit-shl (cast_Inst ~a) (as ui32 POS_A))
           (bit-shl (cast_Inst ~b) (as ui32 POS_vB)) (bit-shl (cast_Inst ~c) (as ui32 POS_vC))
           (bit-shl (cast_Inst ~k) (as ui32 POS_k))))
(defmacro CREATE_ABx (o a bc)
  `(bit-or (bit-shl (cast_Inst ~o) (as ui32 POS_OP)) (bit-shl (cast_Inst ~a) (as ui32 POS_A))
           (bit-shl (cast_Inst ~bc) (as ui32 POS_Bx))))
(defmacro CREATE_Ax (o a)
  `(bit-or (bit-shl (cast_Inst ~o) (as ui32 POS_OP)) (bit-shl (cast_Inst ~a) (as ui32 POS_Ax))))
(defmacro CREATE_sJ (o j k)
  `(bit-or (bit-shl (cast_Inst ~o) (as ui32 POS_OP)) (bit-shl (cast_Inst ~j) (as ui32 POS_sJ))
           (bit-shl (cast_Inst ~k) (as ui32 POS_k))))

; ---- the opcode table ----
; Each row: the opcode, then its mode bits: MM (calls a metamethod), OT (sets
; top for the next one), IT (uses top from the previous one), T (a test; the
; next one is a jump), A (sets register A), and the instruction format. ORDER OP.
(defmacro with-opcodes (gen)
  `(~gen
    ((OP_MOVE 0 0 0 0 1 iABC) (OP_LOADI 0 0 0 0 1 iAsBx) (OP_LOADF 0 0 0 0 1 iAsBx)
     (OP_LOADK 0 0 0 0 1 iABx) (OP_LOADKX 0 0 0 0 1 iABx) (OP_LOADFALSE 0 0 0 0 1 iABC)
     (OP_LFALSESKIP 0 0 0 0 1 iABC) (OP_LOADTRUE 0 0 0 0 1 iABC) (OP_LOADNIL 0 0 0 0 1 iABC)
     (OP_GETUPVAL 0 0 0 0 1 iABC) (OP_SETUPVAL 0 0 0 0 0 iABC) (OP_GETTABUP 0 0 0 0 1 iABC)
     (OP_GETTABLE 0 0 0 0 1 iABC) (OP_GETI 0 0 0 0 1 iABC) (OP_GETFIELD 0 0 0 0 1 iABC)
     (OP_SETTABUP 0 0 0 0 0 iABC) (OP_SETTABLE 0 0 0 0 0 iABC) (OP_SETI 0 0 0 0 0 iABC)
     (OP_SETFIELD 0 0 0 0 0 iABC) (OP_NEWTABLE 0 0 0 0 1 ivABC) (OP_SELF 0 0 0 0 1 iABC)
     (OP_ADDI 0 0 0 0 1 iABC) (OP_ADDK 0 0 0 0 1 iABC) (OP_SUBK 0 0 0 0 1 iABC)
     (OP_MULK 0 0 0 0 1 iABC) (OP_MODK 0 0 0 0 1 iABC) (OP_POWK 0 0 0 0 1 iABC)
     (OP_DIVK 0 0 0 0 1 iABC) (OP_IDIVK 0 0 0 0 1 iABC) (OP_BANDK 0 0 0 0 1 iABC)
     (OP_BORK 0 0 0 0 1 iABC) (OP_BXORK 0 0 0 0 1 iABC) (OP_SHLI 0 0 0 0 1 iABC)
     (OP_SHRI 0 0 0 0 1 iABC) (OP_ADD 0 0 0 0 1 iABC) (OP_SUB 0 0 0 0 1 iABC)
     (OP_MUL 0 0 0 0 1 iABC) (OP_MOD 0 0 0 0 1 iABC) (OP_POW 0 0 0 0 1 iABC)
     (OP_DIV 0 0 0 0 1 iABC) (OP_IDIV 0 0 0 0 1 iABC) (OP_BAND 0 0 0 0 1 iABC)
     (OP_BOR 0 0 0 0 1 iABC) (OP_BXOR 0 0 0 0 1 iABC) (OP_SHL 0 0 0 0 1 iABC)
     (OP_SHR 0 0 0 0 1 iABC) (OP_MMBIN 1 0 0 0 0 iABC) (OP_MMBINI 1 0 0 0 0 iABC)
     (OP_MMBINK 1 0 0 0 0 iABC) (OP_UNM 0 0 0 0 1 iABC) (OP_BNOT 0 0 0 0 1 iABC)
     (OP_NOT 0 0 0 0 1 iABC) (OP_LEN 0 0 0 0 1 iABC) (OP_CONCAT 0 0 0 0 1 iABC)
     (OP_CLOSE 0 0 0 0 0 iABC) (OP_TBC 0 0 0 0 0 iABC) (OP_JMP 0 0 0 0 0 isJ)
     (OP_EQ 0 0 0 1 0 iABC) (OP_LT 0 0 0 1 0 iABC) (OP_LE 0 0 0 1 0 iABC)
     (OP_EQK 0 0 0 1 0 iABC) (OP_EQI 0 0 0 1 0 iABC) (OP_LTI 0 0 0 1 0 iABC)
     (OP_LEI 0 0 0 1 0 iABC) (OP_GTI 0 0 0 1 0 iABC) (OP_GEI 0 0 0 1 0 iABC)
     (OP_TEST 0 0 0 1 0 iABC) (OP_TESTSET 0 0 0 1 1 iABC) (OP_CALL 0 1 1 0 1 iABC)
     (OP_TAILCALL 0 1 1 0 1 iABC) (OP_RETURN 0 0 1 0 0 iABC) (OP_RETURN0 0 0 0 0 0 iABC)
     (OP_RETURN1 0 0 0 0 0 iABC) (OP_FORLOOP 0 0 0 0 1 iABx) (OP_FORPREP 0 0 0 0 1 iABx)
     (OP_TFORPREP 0 0 0 0 0 iABx) (OP_TFORCALL 0 0 0 0 0 iABC) (OP_TFORLOOP 0 0 0 0 1 iABx)
     (OP_SETLIST 0 0 1 0 0 ivABC) (OP_CLOSURE 0 0 0 0 1 iABx) (OP_VARARG 0 1 0 0 1 iABC)
     (OP_GETVARG 0 0 0 0 1 iABC) (OP_ERRNNIL 0 0 0 0 0 iABx) (OP_VARARGPREP 0 0 0 0 0 iABC)
     (OP_EXTRAARG 0 0 0 0 0 iAx))))

; luaP_opmodes from the rows: MM<<7 | OT<<6 | IT<<5 | T<<4 | A<<3 | format. The
; macro makes the whole defvar: an initializer isn't macroexpanded (ISSUE-036).
(defmacro defopmodes (rows)
  (let (vals (node-list-new (rows 'line))
        n (ast-len rows)
        i 0)
    (while (< i n)
      (let (r (ast-at rows i)
            m ((ast-at r 6) 's)
            fmt (cond (symbol-is m "iABC") 0 (symbol-is m "ivABC") 1 (symbol-is m "iABx") 2
                      (symbol-is m "iAsBx") 3 (symbol-is m "iAx") 4 (symbol-is m "isJ") 5
                      true -1)  ; enum OpMode
            v (bit-or (bit-shl ((ast-at r 1) 'i) 7) (bit-shl ((ast-at r 2) 'i) 6)
                      (bit-shl ((ast-at r 3) 'i) 5) (bit-shl ((ast-at r 4) 'i) 4)
                      (bit-shl ((ast-at r 5) 'i) 3) fmt))
        (node-push vals (node-int v)))
      (set! i (+ i 1)))
    `(defvar luaP_opmodes:(array ui8 85) (array ui8 ~@vals))))  ; NUM_OPCODES

(with-opcodes defopmodes)

(defmacro testITMode (m) `(!= (bit-and (aref luaP_opmodes ~m) 0x20) 0))

; Whether the instruction uses top: OP_VARARGPREP does, and so do those taking
; the values the previous instruction left.
(defn luaP_isIT (i:Instruction):i32
  (let (op:i32 (GET_OPCODE i))
    (cond (= op OP_SETLIST) (return (if (= (GETARG_vB i) 0) 1 0))
          (= op OP_VARARGPREP) (return 1)
          true (return (if (and (testITMode op) (= (GETARG_B i) 0)) 1 0)))))
