; The core's macros, from lobject.h, lstate.h and the other internal headers,
; added as the ported modules need them. A module using them imports those
; headers itself, for the types the expansions name.
;
; Copyright (C) 1994-2026 Lua.org, PUC-Rio.
(ns lua.core)

; ---- llimits.h ----
(defconst MAX_LMEM 9223372036854775807)  ; l_mem is ptrdiff_t (ISSUE-029)

; C's arithmetic on lua_Integer, done unsigned so that it wraps.
(defmacro intop (op v1 v2) `(l_castU2S (~op (l_castS2U ~v1) (l_castS2U ~v2))))

; ---- lobject.h: type tags ----

(defmacro makevariant (t v) `(bit-or ~t (bit-shl ~v 4)))

; The variant tags, makevariant(type, variant) written out (ISSUE-029).
(defconst LUA_VNIL 0)
(defconst LUA_VEMPTY 16)      ; an empty slot, which may differ from nil
(defconst LUA_VABSTKEY 32)    ; what a missing key gives
(defconst LUA_VNOTABLE 48)    ; a fast get of a non-table
(defconst LUA_VFALSE 1)
(defconst LUA_VTRUE 17)
(defconst LUA_VLIGHTUSERDATA 2)
(defconst LUA_VNUMINT 3)
(defconst LUA_VNUMFLT 19)
(defconst LUA_VSHRSTR 4)
(defconst LUA_VLNGSTR 20)
(defconst LUA_VTABLE 5)
(defconst LUA_VLCL 6)         ; a Lua closure
(defconst LUA_VLCF 22)        ; a light C function
(defconst LUA_VCCL 38)        ; a C closure
(defconst LUA_VUSERDATA 7)
(defconst LUA_VTHREAD 8)
(defconst LUA_VUPVAL 9)
(defconst LUA_VPROTO 10)

(defmacro rawtt (o) `(~o 'tt_))
(defmacro val_ (o) `(~o 'value_))
(defmacro novariant (t) `(bit-and ~t 0x0F))
(defmacro withvariant (t) `(bit-and ~t 0x3F))
(defmacro ttypetag (o) `(withvariant (rawtt ~o)))
(defmacro ttype (o) `(novariant (rawtt ~o)))
(defmacro checktag (o t) `(= (rawtt ~o) ~t))
(defmacro checktype (o t) `(= (ttype ~o) ~t))
(defmacro ctb (t) `(cast_uchar (bit-or ~t BIT_ISCOLLECTABLE)))  ; the tag of a collectable
(defmacro iscollectable (o) `(!= (bit-and (rawtt ~o) BIT_ISCOLLECTABLE) 0))

; A stack slot's value: StackValue is a union over a TValue.
(defmacro s2v (o) `(ref (~o 'val)))

; Copies a value and its tag only: on the stack, a TValue's padding holds the
; tbclist's 'delta', which a whole-struct copy would clobber.
(defmacro setobj (L obj1 obj2)
  (let (a (gensym) b (gensym))
    `(let ((~a (ptr TValue)) ~obj1
           (~b (ptr TValue)) ~obj2)
       (set! (~a 'value_) (~b 'value_))
       (set! (~a 'tt_) (~b 'tt_)))))
(defmacro setobjs2s (L o1 o2) `(setobj ~L (s2v ~o1) (s2v ~o2)))
(defmacro setobj2s (L o1 o2) `(setobj ~L (s2v ~o1) ~o2))
(defmacro setobj2t (L o1 o2) `(setobj ~L ~o1 ~o2))
(defmacro setobj2n (L o1 o2) `(setobj ~L ~o1 ~o2))

(defmacro gcvalue (o) `((val_ ~o) 'gc))
(defmacro obj2gco (v) `(unsafe/cast (ptr GCObject) ~v))
(defmacro gco2ts (o) `(unsafe/cast (ptr TString) ~o))
(defmacro gco2t (o) `(unsafe/cast (ptr Table) ~o))
(defmacro gco2u (o) `(unsafe/cast (ptr Udata) ~o))
(defmacro gco2lcl (o) `(unsafe/cast (ptr LClosure) ~o))
(defmacro gco2ccl (o) `(unsafe/cast (ptr CClosure) ~o))
(defmacro gco2cl (o) `(unsafe/cast (ptr Closure) ~o))
(defmacro gco2p (o) `(unsafe/cast (ptr Proto) ~o))
(defmacro gco2th (o) `(unsafe/cast (ptr lua_State) ~o))
(defmacro gco2upv (o) `(unsafe/cast (ptr UpVal) ~o))

; ---- nil, empty and booleans ----
(defmacro ttisnil (v) `(checktype ~v LUA_TNIL))
(defmacro ttisstrictnil (o) `(checktag ~o LUA_VNIL))
(defmacro isabstkey (v) `(checktag ~v LUA_VABSTKEY))
(defmacro isempty (v) `(ttisnil ~v))
(defmacro tagisempty (tag) `(= (novariant ~tag) LUA_TNIL))
(defmacro setnilvalue (obj) `(set! (~obj 'tt_) LUA_VNIL))
(defmacro setempty (v) `(set! (~v 'tt_) LUA_VEMPTY))
(defmacro ttisboolean (o) `(checktype ~o LUA_TBOOLEAN))
(defmacro ttisfalse (o) `(checktag ~o LUA_VFALSE))
(defmacro ttistrue (o) `(checktag ~o LUA_VTRUE))
(defmacro l_isfalse (o) `(or (ttisfalse ~o) (ttisnil ~o)))
(defmacro tagisfalse (t) `(or (= ~t LUA_VFALSE) (= (novariant ~t) LUA_TNIL)))
(defmacro setbfvalue (obj) `(set! (~obj 'tt_) LUA_VFALSE))
(defmacro setbtvalue (obj) `(set! (~obj 'tt_) LUA_VTRUE))

; ---- numbers ----
(defmacro ttisnumber (o) `(checktype ~o LUA_TNUMBER))
(defmacro ttisfloat (o) `(checktag ~o LUA_VNUMFLT))
(defmacro ttisinteger (o) `(checktag ~o LUA_VNUMINT))
(defmacro fltvalue (o) `((val_ ~o) 'n))
(defmacro ivalue (o) `((val_ ~o) 'i))
(defmacro nvalue (o)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~o)
       (if (ttisinteger ~a) (cast_num (ivalue ~a)) (fltvalue ~a)))))
(defmacro setfltvalue (obj x)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~obj)
       (set! ((~a 'value_) 'n) ~x)
       (set! (~a 'tt_) LUA_VNUMFLT))))
(defmacro chgfltvalue (obj x) `(set! ((~obj 'value_) 'n) ~x))
(defmacro setivalue (obj x)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~obj)
       (set! ((~a 'value_) 'i) ~x)
       (set! (~a 'tt_) LUA_VNUMINT))))
(defmacro chgivalue (obj x) `(set! ((~obj 'value_) 'i) ~x))

; ---- strings ----
(defmacro ttisstring (o) `(checktype ~o LUA_TSTRING))
(defmacro ttisshrstring (o) `(checktag ~o (ctb LUA_VSHRSTR)))
(defmacro ttislngstring (o) `(checktag ~o (ctb LUA_VLNGSTR)))
(defmacro tsvalue (o) `(gco2ts (gcvalue ~o)))
(defmacro setsvalue (L obj x)
  (let (a (gensym) s (gensym))
    `(let ((~a (ptr TValue)) ~obj
           (~s (ptr TString)) ~x)
       (set! ((~a 'value_) 'gc) (obj2gco ~s))
       (set! (~a 'tt_) (ctb (~s 'tt))))))
(defmacro setsvalue2s (L o s) `(setsvalue ~L (s2v ~o) ~s))
(defmacro setsvalue2n (L o s) `(setsvalue ~L ~o ~s))

(defmacro strisshr (ts) `(>= (~ts 'shrlen) 0))
; A short string's bytes start where a long one keeps its 'contents' pointer.
(defmacro rawgetshrstr (ts) `(as (ptr i8) (as ptr (ref (~ts 'contents)))))
(defmacro getshrstr (ts) `(rawgetshrstr ~ts))
(defmacro getlngstr (ts) `(~ts 'contents))
(defmacro getstr (ts)
  (let (a (gensym))
    `(let ((~a (ptr TString)) ~ts)
       (if (strisshr ~a) (rawgetshrstr ~a) (~a 'contents)))))
(defmacro tsslen (ts)
  (let (a (gensym))
    `(let ((~a (ptr TString)) ~ts)
       (if (strisshr ~a) (cast_sizet (~a 'shrlen)) ((~a 'u) 'lnglen)))))

(defmacro sizestrshr (l) `(+ (offsetof TString contents) ~l 1))

; A userdata's memory follows its user values, or the header when it has none.
(defmacro udatamemoffset (nuv)
  `(if (= ~nuv 0)
     (offsetof Udata0 bindata)
     (+ (offsetof Udata uv) (* (cast_sizet (sizeof UValue)) (cast_sizet ~nuv)))))
(defmacro sizeudata (nuv nb) `(+ (udatamemoffset ~nuv) ~nb))

; 's' modulo a power of two.
(defmacro lmod (s size) `(bit-and (cast_uint ~s) (cast_uint (- ~size 1))))

; ---- tables, userdata and closures ----
(defmacro ttistable (o) `(checktag ~o (ctb LUA_VTABLE)))
(defmacro hvalue (o) `(gco2t (gcvalue ~o)))
(defmacro sethvalue (L obj x)
  (let (a (gensym) t (gensym))
    `(let ((~a (ptr TValue)) ~obj
           (~t (ptr Table)) ~x)
       (set! ((~a 'value_) 'gc) (obj2gco ~t))
       (set! (~a 'tt_) (ctb LUA_VTABLE)))))
(defmacro sethvalue2s (L o h) `(sethvalue ~L (s2v ~o) ~h))
(defmacro ttisfulluserdata (o) `(checktag ~o (ctb LUA_VUSERDATA)))
(defmacro uvalue (o) `(gco2u (gcvalue ~o)))
(defmacro ttisfunction (o) `(checktype ~o LUA_TFUNCTION))
(defmacro ttisLclosure (o) `(checktag ~o (ctb LUA_VLCL)))
(defmacro ttislcf (o) `(checktag ~o LUA_VLCF))
(defmacro ttisCclosure (o) `(checktag ~o (ctb LUA_VCCL)))
(defmacro clLvalue (o) `(gco2lcl (gcvalue ~o)))
(defmacro clCvalue (o) `(gco2ccl (gcvalue ~o)))
(defmacro setnilvalue2s (o) `(setnilvalue (s2v ~o)))

; ---- hash nodes (lobject.h) ----
; The node type is spelled `c/Node` by its users (ISSUE-034), so no macro here names it.
(defmacro keytt (n) `((~n 'u) 'key_tt))
(defmacro keyval (n) `((~n 'u) 'key_val))
(defmacro keyisnil (n) `(= (keytt ~n) LUA_TNIL))
(defmacro keyisinteger (n) `(= (keytt ~n) LUA_VNUMINT))
(defmacro keyival (n) `((keyval ~n) 'i))
(defmacro keyisshrstr (n) `(= (keytt ~n) (ctb LUA_VSHRSTR)))
(defmacro keystrval (n) `(gco2ts ((keyval ~n) 'gc)))
(defmacro setnilkey (n) `(set! ((~n 'u) 'key_tt) LUA_TNIL))
(defmacro keyiscollectable (n) `(!= (bit-and (keytt ~n) BIT_ISCOLLECTABLE) 0))
(defmacro gckey (n) `((keyval ~n) 'gc))
(defmacro gckeyN (n) `(if (keyiscollectable ~n) (gckey ~n) (as (ptr GCObject) null)))
(defmacro setdeadkey (n) `(set! ((~n 'u) 'key_tt) LUA_TDEADKEY))
(defmacro keyisdead (n) `(= (keytt ~n) LUA_TDEADKEY))
(defmacro setnodekey (node obj)
  (let (n (gensym) o (gensym))
    `(let (~n ~node
           (~o (ptr TValue)) ~obj)
       (set! ((~n 'u) 'key_val) (~o 'value_))
       (set! ((~n 'u) 'key_tt) (~o 'tt_)))))
(defmacro getnodekey (L obj node)
  (let (n (gensym) o (gensym))
    `(let ((~o (ptr TValue)) ~obj
           ~n ~node)
       (set! (~o 'value_) ((~n 'u) 'key_val))
       (set! (~o 'tt_) ((~n 'u) 'key_tt)))))
(defmacro twoto (x) `(bit-shl (as ui32 1) (as ui32 ~x)))
(defmacro sizenode (t) `(twoto (~t 'lsizenode)))
(defmacro pvalue (o) `((val_ ~o) 'p))
(defmacro fvalue (o) `((val_ ~o) 'f))
(defmacro isextstr (o) `(and (ttislngstring ~o) (!= ((tsvalue ~o) 'shrlen) LSTRREG)))
(defmacro num-isnan (a) `(!= ~a ~a))

; ---- ltable.h ----
(defmacro gnode (t i) `(p+ (~t 'node) ~i))
(defmacro gval (n) `(ref (~n 'i_val)))
(defmacro gnext (n) `((~n 'u) 'next))
(defmacro set-gnext (n v) `(set! ((~n 'u) 'next) ~v))  ; set! won't expand gnext (ISSUE-020)
(defconst maskflags 0x3F)     ; ~(~0u << (TM_EQ + 1)): a bit per fast-tested metamethod
(defconst NOTBITDUMMY 0xBF)   ; cast_byte(~BITDUMMY)
(defmacro invalidateTMcache (t) `(set! (~t 'flags) (bit-and (~t 'flags) (bit-xor maskflags 0xFF))))
(defmacro isdummy (t) `(!= (bit-and (~t 'flags) BITDUMMY) 0))
(defmacro setnodummy (t) `(set! (~t 'flags) (bit-and (~t 'flags) NOTBITDUMMY)))
(defmacro setdummy (t) `(set! (~t 'flags) (bit-or (~t 'flags) BITDUMMY)))
(defmacro allocsizenode (t) `(if (isdummy ~t) (as ui32 0) (sizenode ~t)))
; The array part: values at negative indices from 'array', then an unsigned
; (the length hint), then the tags.
(defmacro getArrTag (t k) `(p+ (p+ (unsafe/cast (ptr ui8) (~t 'array)) 4) ~k))
(defmacro getArrVal (t k) `(p+ (~t 'array) (- -1 (as i64 ~k))))
(defmacro lenhint (t) `(unsafe/cast (ptr ui32) (~t 'array)))
(defmacro arr2obj (h k val)
  `(do (set! (~val 'tt_) (deref (getArrTag ~h ~k)))
       (set! (~val 'value_) (deref (getArrVal ~h ~k)))))
(defmacro obj2arr (h k val)
  `(do (set! (deref (getArrTag ~h ~k)) (~val 'tt_))
       (set! (deref (getArrVal ~h ~k)) (~val 'value_))))
(defmacro farr2val (h k tag res)
  `(do (set! (~res 'tt_) ~tag)
       (set! (~res 'value_) (deref (getArrVal ~h ~k)))))
(defmacro fval2arr (h k tag val)
  `(do (set! (deref ~tag) (~val 'tt_))
       (set! (deref (getArrVal ~h ~k)) (~val 'value_))))
; 'tag' gets the tag of t[k], and 'res' its value unless it is empty.
(defmacro table-fastgeti (t k res tag)
  (let (h (gensym) u (gensym))
    `(let ((~h (ptr Table)) ~t
           (~u lua_Unsigned) (- (l_castS2U ~k) 1))
       (if (< ~u (as lua_Unsigned (~h 'asize)))
         (do (set! ~tag (deref (getArrTag ~h ~u)))
             (when (not (tagisempty ~tag)) (farr2val ~h ~u ~tag ~res)))
         (set! ~tag (table-getint ~h ~k ~res))))))
; 'hres' gets HOK when t[k] was set, else where to finish the set.
(defmacro table-fastseti (t k val hres)
  (let (h (gensym) u (gensym) tg (gensym))
    `(let ((~h (ptr Table)) ~t
           (~u lua_Unsigned) (- (l_castS2U ~k) 1))
       (if (< ~u (as lua_Unsigned (~h 'asize)))
         (let ((~tg (ptr ui8)) (getArrTag ~h ~u))
           (if (or (checknoTM (~h 'metatable) TM_NEWINDEX) (not (tagisempty (deref ~tg))))
             (do (fval2arr ~h ~u ~tg ~val) (set! ~hres HOK))
             (set! ~hres (bit-xor (unsafe/cast i32 ~u) -1))))
         (set! ~hres (table-psetint ~h ~k ~val))))))

; ---- lvm.h ----
; Float 'n' from a number, without string coercion; false if it isn't one.
(defmacro tonumberns (o n)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~o)
       (cond (ttisfloat ~a) (do (set! ~n (fltvalue ~a)) true)
             (ttisinteger ~a) (do (set! ~n (cast_num (ivalue ~a))) true)
             true false))))
; Integer '*i' from a number, without string coercion: a float must be integral.
(defmacro tointegerns (o i)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~o)
       (if (ttisinteger ~a)
         (do (set! (deref ~i) (ivalue ~a)) true)
         (!= (vm-tointegerns ~a ~i F2Ieq) 0)))))

; ---- ltm.h ----
(defmacro notm (tm) `(ttisnil ~tm))
(defmacro ttypename (x) `(aref tm-typenames (+ ~x 1)))
; The metamethod 'e' of 'mt', or null; a miss is cached in the table's flags.
(defmacro gfasttm (g mt e)
  (let (m (gensym))
    `(let ((~m (ptr Table)) ~mt)
       (if (or (= ~m null) (!= (bit-and (as ui32 (~m 'flags)) (bit-shl (as ui32 1) (as ui32 ~e))) 0))
         (as (ptr TValue) null)
         (tm-gettm ~m ~e (aref (~g 'tmname) ~e))))))
(defmacro checknoTM (mt e)
  (let (m (gensym))
    `(let ((~m (ptr Table)) ~mt)
       (or (= ~m null) (!= (bit-and (as ui32 (~m 'flags)) (bit-shl (as ui32 1) (as ui32 ~e))) 0)))))
(defmacro fasttm (L mt e) `(gfasttm (G ~L) ~mt ~e))

; ---- lstate.h ----
(defmacro G (L) `(~L 'l_G))
; Whether the state is fully built: its nilvalue is a nil only then.
(defmacro completestate (g) `(ttisnil (ref (~g 'nilvalue))))

; ---- lgc.h: colours ----
(defconst WHITEBITS 0x18)  ; bit2mask(WHITE0BIT, WHITE1BIT)
(defmacro iswhite (x) `(!= (bit-and (~x 'marked) WHITEBITS) 0))
(defmacro otherwhite (g) `(bit-xor (~g 'currentwhite) WHITEBITS))
(defmacro isdead (g v) `(!= (bit-and (~v 'marked) (otherwhite ~g)) 0))
(defmacro changewhite (x) `(set! (~x 'marked) (bit-xor (~x 'marked) WHITEBITS)))

(defconst BLACKMASK 0x20)  ; bitmask(BLACKBIT)
(defmacro isblack (x) `(!= (bit-and (~x 'marked) BLACKMASK) 0))
(defmacro nw2black (x) `(set! (~x 'marked) (bit-or (~x 'marked) BLACKMASK)))

; A black object pointing to a white one must be fixed up for the collector.
(defmacro gc-objbarrier (L p o)
  `(when (and (isblack ~p) (iswhite ~o))
     (gc-barrier-fn ~L (obj2gco ~p) (obj2gco ~o))))
(defmacro gc-barrier (L p v)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~v)
       (when (iscollectable ~a) (gc-objbarrier ~L ~p (gcvalue ~a))))))
(defmacro gc-objbarrierback (L p o)
  `(when (and (isblack ~p) (iswhite ~o))
     (gc-barrierback-fn ~L (obj2gco ~p))))
(defmacro gc-barrierback (L p v)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~v)
       (when (iscollectable ~a) (gc-objbarrierback ~L ~p (gcvalue ~a))))))

; Row 'i' of the API's string cache. A C 2-D array's row won't decay (ISSUE-031).
(defmacro strcache-row (g i) `(unsafe/cast (ptr (ptr TString)) (ref (aref (~g 'strcache) ~i))))

; CallInfo's status bits from CIST_FRESH on, built with cast() (ISSUE-029).
(defconst CIST_FRESH 0x10000)      ; a fresh vm-execute frame
(defconst CIST_CLSRET 0x20000)     ; closing tbc variables at a return
(defconst CIST_TBC 0x40000)        ; has tbc variables
(defconst CIST_OAH 0x80000)        ; original allowhook
(defconst CIST_HOOKED 0x100000)    ; running a debug hook
(defconst CIST_YPCALL 0x200000)    ; a yieldable protected call
(defconst CIST_TAIL 0x400000)      ; a tail call
(defconst CIST_HOOKYIELD 0x800000) ; the last hook yielded
(defconst CIST_FIN 0x1000000)      ; a finalizer

; Whether the call runs Lua code, not C and not a hook.
(defmacro isLua (ci) `(= (bit-and (~ci 'callstatus) CIST_C) 0))
(defmacro isLuacode (ci) `(= (bit-and (~ci 'callstatus) (bit-or CIST_C CIST_HOOKED)) 0))
(defmacro ci_func (ci) `(clLvalue (s2v ((~ci 'func) 'p))))

; ---- lgc.h ----
(defmacro gc-check (L) `(when (<= ((G ~L) 'GCdebt) 0) (gc-step ~L)))

; ---- lmem.h ----
(defmacro mem-error (L) `(do-throw ~L LUA_ERRMEM))
(defmacro mem-freemem (L b s) `(mem-free-fn ~L ~b ~s))
(defmacro mem-newvector (L n t)
  `(unsafe/cast (ptr ~t) (mem-malloc ~L (* (cast_sizet ~n) (cast_sizet (sizeof ~t))) 0)))
(defmacro mem-reallocvector (L v oldn n t)
  `(unsafe/cast (ptr ~t) (mem-realloc ~L (as ptr ~v)
                                         (* (cast_sizet ~oldn) (cast_sizet (sizeof ~t)))
                                         (* (cast_sizet ~n) (cast_sizet (sizeof ~t))))))
; mem-checksize never fires for an int count: sizeof(int) < sizeof(size_t).
(defmacro mem-newvectorchecked (L n t) `(mem-newvector ~L ~n ~t))
; mem-limit-n is the identity here: MAX_SIZET/sizeof(t) exceeds every int limit.
(defmacro mem-growvector (L v nelems size T limit e)
  `(set! ~v (unsafe/cast (ptr ~T) (mem-growaux ~L (as ptr ~v) ~nelems (ref ~size)
                                                 (unsafe/cast ui32 (sizeof ~T)) ~limit ~e))))
(defmacro mem-shrinkvector (L v size fs T)
  `(set! ~v (unsafe/cast (ptr ~T) (mem-shrinkvector-fn ~L (as ptr ~v) (ref ~size) ~fs
                                                      (unsafe/cast ui32 (sizeof ~T))))))

; ---- lstring.h ----
(defmacro string-newliteral (L s) `(string-newlstr ~L ~s (strlen ~s)))
(defmacro mem-free (L b T) `(mem-free-fn ~L (as ptr ~b) (cast_sizet (sizeof ~T))))
; The element type is an argument: there's no sizeof of an expression (ISSUE-011).
(defmacro mem-freearray (L b n T)
  `(mem-free-fn ~L (as ptr ~b) (* (cast_sizet ~n) (cast_sizet (sizeof ~T)))))

; ---- ldo.h ----
; A stack position as a byte offset, which survives the stack's reallocation.
(defmacro savestack (L pt) `(byte-diff ~pt ((~L 'stack) 'p)))
(defmacro restorestack (L n)
  `(unsafe/cast (ptr StackValue) (p+ (unsafe/cast (ptr i8) ((~L 'stack) 'p)) ~n)))
; Room for 'n' more slots, growing the stack if need be.
(defmacro do-checkstack (L n)
  `(when (<= (stack-diff ((~L 'stack_last) 'p) ((~L 'top) 'p)) ~n)
     (do-growstack ~L ~n 1)))
; The same, keeping 'p', a stack pointer variable, valid across a reallocation.
(defmacro checkstackp (L n p)
  (let (t (gensym))
    `(when (<= (stack-diff ((~L 'stack_last) 'p) ((~L 'top) 'p)) ~n)
       (let (~t (savestack ~L ~p))
         (do-growstack ~L ~n 1)
         (set! ~p (restorestack ~L ~t))))))
; How many slots 'q' is above 'p' (ISSUE-021).
(defmacro stack-diff (q p) `(/ (byte-diff ~q ~p) (sizeof StackValue)))

; ---- lfunc.h ----
(defmacro sizeCclosure (n)
  `(+ (offsetof CClosure upvalue) (* (cast_sizet (sizeof TValue)) (cast_sizet ~n))))
(defmacro sizeLclosure (n)
  `(+ (offsetof LClosure upvals) (* (cast_sizet (sizeof (ptr UpVal))) (cast_sizet ~n))))
; Whether the thread is in the list of threads with open upvalues.
(defmacro isintwups (L) `(!= (~L 'twups) ~L))
; An open upvalue points into the stack; a closed one at its own 'value'.
(defmacro upisopen (up) `(!= ((~up 'v) 'p) (ref ((~up 'u) 'value))))
(defmacro uplevel (up) `(unsafe/cast (ptr StackValue) ((~up 'v) 'p)))

; ---- lzio.h ----
; The next byte, or EOZ. 'n' is unsigned, so it is tested before it drops.
(defmacro zgetc (z)
  (let (a (gensym))
    `(let ((~a (ptr ZIO)) ~z)
       (if (> (~a 'n) 0)
         (do (set! (~a 'n) (- (~a 'n) 1))
             (let (c:i32 (as i32 (cast_uchar (deref (~a 'p)))))
               (set! (~a 'p) (p+ (~a 'p) 1))
               c))
         (do (set! (~a 'n) (- (~a 'n) 1))
             (zio-fill ~a))))))
(defmacro zio-buffer (b) `(~b 'buffer))
(defmacro zio-sizebuffer (b) `(~b 'buffsize))
(defmacro zio-bufflen (b) `(~b 'n))
(defmacro zio-buffremove (b i) `(set! (~b 'n) (- (~b 'n) (cast_sizet ~i))))
(defmacro zio-resetbuffer (b) `(set! (~b 'n) 0))
(defmacro zio-initbuffer (L b) `(do (set! (~b 'buffer) null) (set! (~b 'buffsize) 0)))
(defmacro zio-resizebuffer (L b size)
  (let (m (gensym) sz (gensym))
    `(let ((~m (ptr Mbuffer)) ~b
           (~sz usize) ~size)
       (set! (~m 'buffer) (unsafe/cast (ptr i8) (mem-saferealloc ~L (as ptr (~m 'buffer)) (~m 'buffsize) ~sz)))
       (set! (~m 'buffsize) ~sz))))
(defmacro zio-freebuffer (L b) `(zio-resizebuffer ~L ~b 0))

; ---- shared by the core modules, which import one another in cycles ----
; A cycle carries no macro, so every macro a second module uses lives here (ISSUE-052).

(defmacro adjustresults (L nres)
  `(when (and (<= ~nres LUA_MULTRET) (< (as ptr (((~L 'ci) 'top) 'p)) (as ptr ((~L 'top) 'p))))
     (set! (((~L 'ci) 'top) 'p) ((~L 'top) 'p))))
(defmacro api_incr_top (L) `(set! ((~L 'top) 'p) (p+ ((~L 'top) 'p) 1)))
(defmacro code-abc (fs o a b c) `(code-abck ~fs ~o ~a ~b ~c 0))
(defmacro code-at (fs pc) `(p+ ((~fs 'f) 'code) ~pc))
(defmacro code-jumpto (fs t) `(code-patchlist ~fs (code-jump ~fs) ~t))
(defmacro code-setmultret (fs e) `(code-setreturns ~fs ~e LUA_MULTRET))
(defmacro copy-exp (dst src) `(memcpy ~dst ~src (sizeof expdesc)))
(defmacro fastget (t k res f tag)
  `(set! ~tag (if (not (ttistable ~t)) LUA_VNOTABLE (~f (hvalue ~t) ~k ~res))))
(defmacro fastset (t k val hres f)
  `(set! ~hres (if (not (ttistable ~t)) HNOTATABLE (~f (hvalue ~t) ~k ~val))))
(defmacro finishfastset (L t v) `(gc-barrierback ~L (gcvalue ~t) ~v))
(defmacro getCcalls (L) `(bit-and (~L 'nCcalls) 0xffff))
(defmacro get_nresults (cs) `(- (cast_int (bit-and ~cs CIST_NRESULTS)) 1))
(defmacro gettotalbytes (g) `(- (~g 'GCtotalbytes) (~g 'GCdebt)))
(defmacro incnny (L) `(set! (~L 'nCcalls) (+ (~L 'nCcalls) 0x10000)))
(defmacro exp-ind (e f) `(((~e 'u) 'ind) ~f))
(defmacro exp-instr (fs e) `(code-at ~fs (exp-u ~e 'info)))  ; &getinstruction(fs, e)
(defmacro isvararg (p) `(!= (bit-and (~p 'flag) (bit-or PF_VAHID PF_VATAB)) 0))
(defmacro lua_getextraspace (L) `(as ptr (p+ (bytes ~L) (- LUA_EXTRASPACE))))
(defmacro mainthread (g) `(ref ((~g 'mainth) 'l)))
(defmacro needvatab (p) `(set! (~p 'flag) (cast_uchar (bit-or (~p 'flag) PF_VATAB))))
(defmacro pcRel (pc p) `(- (cast_int (/ (byte-diff ~pc (~p 'code)) (sizeof Instruction))) 1))
(defmacro resethookcount (L) `(set! (~L 'hookcount) (~L 'basehookcount)))
(defmacro seminfo (ls f) `(((~ls 't) 'seminfo) ~f))
(defmacro set-exp-ind (e f v) `(set! (((~e 'u) 'ind) ~f) ~v))
(defmacro set-exp-u (e f v) `(set! ((~e 'u) ~f) ~v))
(defmacro set-exp-var (e f v) `(set! (((~e 'u) 'var) ~f) ~v))
(defmacro setclLvalue2s (L o cl)
  `(let (a:(ptr TValue) (s2v ~o))
     (set! ((a 'value_) 'gc) (obj2gco ~cl))
     (set! (a 'tt_) (ctb LUA_VLCL))))
(defmacro setgcovalue (obj x)
  (let (a (gensym) gx (gensym))
    `(let ((~a (ptr TValue)) ~obj
           (~gx (ptr GCObject)) ~x)
       (set! ((~a 'value_) 'gc) ~gx)
       (set! (~a 'tt_) (ctb (~gx 'tt))))))
(defmacro setthvalue (L obj x)
  `(let (a:(ptr TValue) ~obj)
     (set! ((a 'value_) 'gc) (obj2gco ~x))
     (set! (a 'tt_) (ctb LUA_VTHREAD))))
(defmacro stacksize (th) `(cast_int (stack-diff ((~th 'stack_last) 'p) ((~th 'stack) 'p))))
; '*n' from a number or a numeric string.
(defmacro tonumber (o n)
  (let (a (gensym))
    `(let ((~a (ptr TValue)) ~o)
       (if (ttisfloat ~a) (do (set! (deref ~n) (fltvalue ~a)) 1) (vm-tonumber ~a ~n)))))
; expdesc's union. A setter for each, as set! won't take a macro place (ISSUE-020).
(defmacro exp-u (e f) `((~e 'u) ~f))
(defmacro exp-var (e f) `(((~e 'u) 'var) ~f))
(defmacro yieldable (L) `(= (bit-and (~L 'nCcalls) 0xffff0000) 0))
