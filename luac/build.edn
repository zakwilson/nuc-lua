;; The port's `luac`: one build.edn makes one program, so the second has its own
;; project, sharing the port's sources.
{:name "luac"
 :opt 2
 :entry "../src/luac.nuc"
 :source-root "../src"
 :cflags ["-I../include" "-I../reference/build/src" "-DLUA_USE_LINUX"]
 :libs ["m"]
 :deps {luacapi {:path "../capi"}}}
