; ISSUE-051: a local bound with a macro's name is still the macro at the head of a
; form, so '(next 'v)' on a local struct pointer 'next' expands the macro.
; expect: prints `5`; actual: `quote needs the node runtime — add (import-use nucleus.node)`
; run: $NUCLEUSC $P -o $W/p && $W/p
; fixed-when-output: 5
(import-use "stdio.h")
(defstruct S v:i32)
(defmacro next (x) `(+ ~x 100))
(defn main ():i32
  (let (s:S (S 5)
        next:(ptr S) &s)
    (printf "%d\n" (next 'v))
    (return 0)))
