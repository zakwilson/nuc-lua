; ISSUE-051: a local bound with a macro's name is still the macro at the head of a
; form, so '(next 'v)' on a local struct pointer 'next' expands the macro.
; expect: the binding refused (fixed, per the ruling); actual: `quote needs the node runtime — add (import-use nucleus.node)`
; run: $NUCLEUSC $P -o $W/p 2>&1 | grep -o "error: cannot bind 'next': 'next' names a macro in scope"
; fixed-when-output: error: cannot bind 'next': 'next' names a macro in scope
(import-use "stdio.h")
(defstruct S v:i32)
(defmacro next (x) `(+ ~x 100))
(defn main ():i32
  (let (s:S (S 5)
        next:(ptr S) &s)
    (printf "%d\n" (next 'v))
    (return 0)))
