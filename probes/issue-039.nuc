; ISSUE-039: a build.edn makes one program; a second, sharing the sources, warns at every build.
; expect: one build.edn's :programs builds both (fixed); actual: a second project, which warns per path
; run: mkdir -p $W/p && cp $P $W/p/main.nuc && printf '{:programs {one "main.nuc" two "main.nuc"}}' > $W/p/build.edn && cd $W/p && $(dirname $NUCLEUSC)/nucleus build >/dev/null 2>&1 && ./build/two
; fixed-when-output: two
(import-use "stdio.h")
(defn main ():i32
  (printf "two\n")
  (return 0))
