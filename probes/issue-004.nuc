; ISSUE-004: a function's address is not a constant in an aggregate initializer.
; expect: prints 3; actual: `defvar: unsupported init symbol 'f'`
; run: $NUCLEUSC $P -o $W/p && $W/p
; fixed-when-output: 3
(import-use "stdio.h")
(defstruct Reg name:CStr func:(fn i32)(i32))
(defn- f (a:i32):i32 (return (+ a 1)))
(defvar regs:(array Reg 2) (array Reg (Reg "f" f) (Reg null null)))
(defn main ():i32 (printf "%d\n" (funcall ((aref regs 0) 'func) 2)) (return 0))
