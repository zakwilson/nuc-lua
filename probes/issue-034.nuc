; ISSUE-034: in a namespaced file, a header's `Node` is silently the prelude's AST Node.
; expect: prints `7`; actual: `field: no field 'u' on struct 'Node'`
; run: $NUCLEUSC --cflag=-I$D $P -o $W/p && $W/p
; fixed-when-output: 7
(ns p34)
(import-use "stdio.h")
(import-use "issue-034.h")
(defn main ():i32
  (let (n:(ptr Node) (alloca Node))
    (set! ((n 'u) 'next) 7)
    (printf "%d\n" ((n 'u) 'next))
    (return 0)))
