;; The port's `lua`. While the migration runs, the stock modules not yet ported
;; link from reference/build/src (scripts/setup.sh); PROGRESS.md lists them.
{:name "lua"
 :opt 2
 :cflags ["-Iinclude" "-DLUA_USE_LINUX"]
 :link-args ["-Wl,-E"]
 :libs ["m" "dl"]
 :deps {luacapi {:path "capi"}}
 :c-sources ["reference/build/src/lapi.c" "reference/build/src/lcode.c"
             "reference/build/src/lctype.c" "reference/build/src/ldebug.c"
             "reference/build/src/ldo.c" "reference/build/src/ldump.c"
             "reference/build/src/lfunc.c" "reference/build/src/lgc.c"
             "reference/build/src/llex.c" "reference/build/src/lmem.c"
             "reference/build/src/lobject.c" "reference/build/src/lopcodes.c"
             "reference/build/src/lparser.c" "reference/build/src/lstate.c"
             "reference/build/src/lstring.c" "reference/build/src/ltable.c"
             "reference/build/src/ltm.c" "reference/build/src/lundump.c"
             "reference/build/src/lvm.c" "reference/build/src/lzio.c"
             "reference/build/src/lauxlib.c" "reference/build/src/lbaselib.c"
             "reference/build/src/lcorolib.c" "reference/build/src/ldblib.c"
             "reference/build/src/liolib.c" "reference/build/src/lmathlib.c"
             "reference/build/src/loadlib.c" "reference/build/src/loslib.c"
             "reference/build/src/lstrlib.c" "reference/build/src/ltablib.c"
             "reference/build/src/lutf8lib.c" "reference/build/src/linit.c"]}
