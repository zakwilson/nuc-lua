;; The port's `lua`. While the migration runs, the stock modules not yet ported
;; link from reference/build/src (scripts/setup.sh); PROGRESS.md lists them.
{:name "lua"
 :opt 2
 :cflags ["-Iinclude" "-Ireference/build/src" "-DLUA_USE_LINUX"]
 :link-args ["-Wl,--dynamic-list=src/lua.dynlist"]
 :libs ["m" "dl"]
 :deps {luacapi {:path "capi"}}
 :c-sources ["reference/build/src/lapi.c"
             "reference/build/src/ldo.c"
             "reference/build/src/lgc.c"
             "reference/build/src/lvm.c"]}
