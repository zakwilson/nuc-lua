 ; A receiver node-type can't type, such as a field of a macro call's result: a
-; struct field's own address rather than a copy of the struct, else its value.
+; struct place's own address rather than a copy of the struct, else its value.
 (defn emit-untyped-receiver (recv:ptr scope:&Scope line:i32):&Val
-  (when (!= (field-place-parts recv) null)
-    (when-some (pa (emit-place-address (unsafe/cast &Node recv) scope line))
+  (when (= g-resolve 0) (return (emit-untyped-receiver-in recv scope line)))
+  (let (d:usize (resolve-depth)
+        v:&Val (emit-untyped-receiver-in recv scope line))
+    (resolve-pop-to d)
+    (return v)))
+
+; A field, `aref` or `deref` form: the forms whose address is never a call's.
+(defn place-form? (n:ptr):bool
+  (when (!= (field-place-parts n) null) (return true))
+  (when (or (!= (node-kind n) NODE-LIST) (= (node-len n) 0)) (return false))
+  (let (h:?&Node (node-at n 0))
+    (return (or (and (= h 'aref) (= (node-len n) 3)) (and (= h 'deref) (= (node-len n) 2))))))
+
+(defn emit-untyped-receiver-in (recv0:ptr scope:&Scope line:i32):&Val
+  (let (recv:ptr (ref-operand-expand recv0))
+    (when (place-form? recv)
+      (when-some (pa (emit-place-address (unsafe/cast &Node recv) scope line))
       (let (ft:&Type (-> pa (_ 'type) (unsafe/cast &Type _) (_ 'elem) (unsafe/cast &Type _)))
         (when (or (= (ft 'kind) TY-STRUCT) (= (ft 'kind) TY-UNION)) (return pa))
         (when (= (ft 'kind) TY-ARRAY)
@@ -8169,7 +8184,7 @@
         (let (t:StrView (new-tmp))
           (emit-load t (type-to-ir ft) (pa 'val) ft)
           (return (alloc-val ft t))))))
-  (return (emit-node recv scope)))
+    (return (emit-node recv scope))))
 
 ; Store a VALUE in a fresh entry-block slot owned by a hidden binding of the
 ; current scope, so `binding-address-val` stays the one owner of its escape taint.
diff --git a/tests/suite-s21.nuc b/tests/suite-s21.nuc
index 89c612f..e0c10c9 100644
--- a/tests/suite-s21.nuc
+++ b/tests/suite-s21.nuc
@@ -4132,6 +4132,28 @@ int main(void) {
 ")))
     (try (check-golden (string-as-view &out) "5 1 1 1\n"))
     (drop &out))
+  ; An element of an array field under a macro call, as `&uvalue(o)->uv[n-1].uv` is.
+  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
+(defstruct UV n:i32)
+(defstruct U pad:i64 uv:(array UV 2))
+(defstruct H u:&U)
+(defmacro uval (h) `(~h 'u))
+(defmacro elem (h i) `(aref ((uval ~h) 'uv) ~i))
+(defn main ():i32
+  (let (u:&U (alloca U)
+        h:&H (alloca H))
+    (set! (h 'u) u)
+    (set! ((aref ((uval h) 'uv) 1) 'n) 7)
+    (let (p:&i32 (ref ((aref ((uval h) 'uv) 1) 'n))
+          q:&i32 (ref ((elem h 0) 'n)))
+      (set! @p (+ @p 1))
+      (set! @q 3)
+      (set! ((elem h 0) 'n) (+ ((elem h 0) 'n) 1)))
+    (printf \"%d %d\\n\" ((aref (u 'uv) 0) 'n) ((aref (u 'uv) 1) 'n)))
+  0)
+")))
+    (try (check-golden (string-as-view &out) "4 8\n"))
+    (drop &out))
   (return (ok)))
 
