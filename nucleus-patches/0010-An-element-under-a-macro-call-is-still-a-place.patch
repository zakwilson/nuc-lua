@@ -7396,7 +7396,7 @@
             (let (t:StrView (new-tmp))
               (emit-load t (type-to-ir ft) (fa 'val) ft)
               (return (alloc-val ft t))))))))
-  (let (p:&Val (emit-node rnode scope)
+  (let (p:&Val (emit-untyped-receiver rnode scope line)
         pk:i32 (-> p (as &Val _) (_ 'type) (unsafe/cast &Type _) (_ 'kind)))
     (when (or (= pk TY-STRUCT) (= pk TY-UNION))
       (die-at line
