+; A receiver node-type can't type, such as a field of a macro call's result: a
+; struct field's own address rather than a copy of the struct, else its value.
+(defn emit-untyped-receiver (recv:ptr scope:&Scope line:i32):&Val
+  (when (!= (field-place-parts recv) null)
+    (when-some (pa (emit-place-address (unsafe/cast &Node recv) scope line))
+      (let (ft:&Type (-> pa (_ 'type) (unsafe/cast &Type _) (_ 'elem) (unsafe/cast &Type _)))
+        (when (or (= (ft 'kind) TY-STRUCT) (= (ft 'kind) TY-UNION)) (return pa))
+        (when (= (ft 'kind) TY-ARRAY)
+          (return (alloc-val (array-decay (as ptr ft)) (pa 'val))))
+        (let (t:StrView (new-tmp))
+          (emit-load t (type-to-ir ft) (pa 'val) ft)
+          (return (alloc-val ft t))))))
+  (return (emit-node recv scope)))
+
 ; Store a VALUE in a fresh entry-block slot owned by a hidden binding of the
 ; current scope, so `binding-address-val` stays the one owner of its escape taint.
 (defn emit-ref-temporary (v:&Val scope:&Scope line:i32):&Val
@@ -13016,8 +13030,9 @@
         (let (t:ptr (as ptr (receiver-type (as ptr rn) scope)))
           (when (and (!= t null) (or (= ((unsafe/cast &Type t) 'kind) TY-STRUCT)
                                      (= ((unsafe/cast &Type t) 'kind) TY-UNION)))
-            (when-some (pa (emit-place-address rn scope line)) (return pa)))))
-      (set! v (emit-node (as ptr rn) scope)))
+            (when-some (pa (emit-place-address rn scope line)) (return pa)))
+          (when (= t null) (set! v (emit-untyped-receiver (as ptr rn) scope line)))))
+      (when (= v null) (set! v (emit-node (as ptr rn) scope))))
     (let (pv:&Val (unsafe/cast &Val v)
           pk:i32 (-> pv (_ 'type) (unsafe/cast &Type _) (_ 'kind)))
       (when (or (= pk TY-STRUCT) (= pk TY-UNION))
diff --git a/tests/suite-s21.nuc b/tests/suite-s21.nuc
index 1490471..89c612f 100644
