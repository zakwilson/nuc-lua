+; The address of the next argument of an aggregate-class list, advancing the list.
+; LLVM's `va_arg` is wrong on AAPCS, and at -O0 on x86-64 it uses a spill it never
+; wrote; `select`, not blocks, so no enclosing phi needs to know (§3, §5).
+(defn emit-va-next (h:StrView fp:bool):StrView
+  (let (sysv:bool (= (va-list-class) VA-SYSV)
+        ; Field offsets, and the 16-byte slot of an FP register.
+        off-p:StrView (va-gep h (if sysv (if fp "4" "0") (if fp "28" "24")))
+        top-p:StrView (va-gep h (if sysv "16" (if fp "16" "8")))
+        stk-p:StrView (va-gep h (if sysv "8" "0"))
+        step:StrView (if fp "16" "8")
+        off:StrView (new-tmp)
+        wide:StrView (new-tmp)
+        inreg:StrView (new-tmp)
+        top:StrView (new-tmp)
+        stk:StrView (new-tmp)
+        next:StrView (new-tmp))
+    (emit g-body-stream "  " off " = load i32, ptr " off-p "\n")
+    (emit g-body-stream "  " wide " = " (if sysv "zext" "sext") " i32 " off " to i64\n")
+    ; SysV counts up to the end of the save area; AAPCS counts up to zero.
+    (if sysv
+      (emit g-body-stream "  " inreg " = icmp ult i32 " off ", " (if fp "176" "48") "\n")
+      (emit g-body-stream "  " inreg " = icmp slt i32 " off ", 0\n"))
+    (emit g-body-stream "  " top " = load ptr, ptr " top-p "\n")
+    (emit g-body-stream "  " stk " = load ptr, ptr " stk-p "\n")
+    (emit g-body-stream "  " next " = add i32 " off ", " step "\n")
+    (let (addr:StrView (va-select inreg "ptr" (va-gep top wide) stk)
+          stk2:StrView (va-select inreg "ptr" stk (va-gep stk "8"))
+          off2:StrView (va-select inreg "i32" next off))
+      (emit g-body-stream "  store i32 " off2 ", ptr " off-p "\n")
+      (emit g-body-stream "  store ptr " stk2 ", ptr " stk-p "\n")
+      (return addr))))
