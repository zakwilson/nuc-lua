+; The refusals table of variadic-functions.md §4.1: what a promoted argument can
+; legally be read as, and what LLVM's `va_arg` reads correctly.
+(defn va-arg-check (ty:&Type line:i32):void
+  (let (k:i32 (ty 'kind))
+    (when (= k TY-PTR)
+      (when (= (ty 'pkind) PTR-REF)
+        (die-at line (fstr "unsafe/va-arg: nothing proves '" (type-display ty)
+                           "' non-null -- read ?" (type-display ty) " and narrow it")))
+      (return))
+    (when (or (= k TY-CSTR) (= k TY-FN) (= k TY-F64)) (return))
+    (when (or (= k TY-F32) (= k TY-F16))
+      (die-at line (fstr "unsafe/va-arg: '" (type-display ty) "' arrives promoted to 'f64' -- read f64 and narrow it")))
+    (when (or (= k TY-F80) (= k TY-F128))
+      (die-at line (fstr "unsafe/va-arg: '" (type-display ty) "' can't be read from a variadic list yet")))
+    (when (!= (type-is-strview ty) 0)
+      (die-at line "unsafe/va-arg: a StrView arrives as its data pointer -- read CStr"))
+    (when (= (is-int-or-bool ty) 0)
+      (die-at line "unsafe/va-arg: a struct can't be read from a variadic list yet"))
+    (let (pt:&Type (if (= g-target-ptr-bytes 2) ty-i16 ty-i32))
+      (when (or (!= (is-bool-type ty) 0) (< (int-width ty) (int-width pt)))
+        (die-at line (fstr "unsafe/va-arg: '" (type-display ty) "' arrives promoted to '"
+                           (type-display pt) "' -- read " (type-display pt) " and narrow it"))))))
