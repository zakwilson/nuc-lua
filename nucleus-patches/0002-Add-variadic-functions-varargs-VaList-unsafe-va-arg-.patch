+        ty:ptr (extract-name-and-type bname (as &Symbol &name) (node-line bname line)))
+    (when (!= (node-len form) 2) (die-at (fc 'line) "va-copy expects 1 arg"))
+    (when (and (!= ty null) (not (type-is-valist (as ?&Type ty))))
+      (die-at (fc 'line) (fstr "with: va-copy makes a VaList, but '" name "' is "
+                               (type-display (as ?&Type ty)))))
