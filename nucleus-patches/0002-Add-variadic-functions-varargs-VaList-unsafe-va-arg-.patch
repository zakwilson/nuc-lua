+; Storage for one list in the entry block, and the slot holding its address.
+(defn va-list-storage (list:StrView slot:StrView):void
+  (va-intrinsics-declare)
+  (emit g-entry-stream "  " list " = alloca " (va-list-ir) ", align " (va-list-align) "\n")
+  (emit g-entry-stream "  " slot " = alloca ptr, align " g-target-ptr-bytes "\n")
+  (emit g-entry-stream "  store ptr " list ", ptr " slot ", align " g-target-ptr-bytes "\n"))
+
+; `:varargs ap`: an owned binding, so that every exit ends the list.
+(defn emit-varargs-entry (fn-scope:&Scope name:Symbol):void
+  (let (mn:StrView (ir-name-token (symbol-as-view name))
+        list:StrView (fstr "%" mn ".list")
+        slot:StrView (fstr "%" mn ".addr")
+        cl:&Cleanup (new Cleanup g-arena))
+    (va-list-storage list slot)
+    (emit g-entry-stream "  call void @llvm.va_start.p0(ptr " list ")\n")
+    (scope-define fn-scope name ty-valist slot 1)
+    (set! @cl (Cleanup-va-end list))
+    (scope-push-cleanup fn-scope (as ptr cl))))
