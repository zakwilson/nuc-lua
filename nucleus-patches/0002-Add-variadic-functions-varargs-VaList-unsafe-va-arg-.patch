+(defn va-intrinsics-declare ():void
+  (when (= g-va-declared 0)
+    (emit g-out "declare void @llvm.va_start.p0(ptr)\n"
+                "declare void @llvm.va_end.p0(ptr)\n"
+                "declare void @llvm.va_copy.p0.p0(ptr, ptr)\n")
+    (set! g-va-declared 1)))
