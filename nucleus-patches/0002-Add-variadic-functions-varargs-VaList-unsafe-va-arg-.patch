+(defn va-select (test:StrView ty:StrView a:StrView b:StrView):StrView
+  (let (r:StrView (new-tmp))
+    (emit g-body-stream "  " r " = select i1 " test ", " ty " " a ", " ty " " b "\n")
+    (return r)))
