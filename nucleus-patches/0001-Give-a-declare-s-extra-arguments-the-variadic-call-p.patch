       (str-into argbuf ", " (abi-arg-frag (as ptr (unsafe/ptr+ (unsafe/cast &Val args) i)))))
     (let (arglist:StrView (string-as-view argbuf))
       (when (!= (ret-info 'kind) ABI-DIRECT)
-        (return (abi-emit-struct-call ret-info ret-ty fnp arglist (+ nargs 1))))
+        (return (abi-emit-struct-call ret-info ret-ty fnp arglist (+ nargs 1) "")))
       (when (= (-> ret-ty (unsafe/cast &Type _) (_ 'kind)) TY-VOID)
