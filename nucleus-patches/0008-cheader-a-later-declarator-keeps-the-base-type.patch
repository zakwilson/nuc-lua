         ; `(*name)(args)` — a function-pointer typedef, which is a pointer
         ; whatever its return and argument types are. It has to be recognized
         ; HERE: the naive fallback would take `int` for the declarator of
@@ -2928,7 +2946,9 @@
             (while (and (< p len) (= (cstr-byte-at buf p) 42))
               (inc! ns)
               (set! p (c-skip-type-quals buf (+ p 1) len)))
-            (when (> ns 0) (set! dty ty-ptr) (set! dbad 0))
