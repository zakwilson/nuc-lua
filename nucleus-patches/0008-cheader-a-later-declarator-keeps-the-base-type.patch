-; A `*` in the span c-parse-type consumed belongs to the FIRST declarator and was
-; already collapsed into `ptr`, so a later one on the same line has no base left
-; (c-header-layout.md §8.2).
-(defn c-span-has-star (buf:ptr start:i64 stop:i64):i32
-  (let (p:i64 start)
+; The `*`s in the span c-parse-type consumed: they belong to the FIRST
+; declarator, so a later one on the same line starts from the base under them.
+(defn c-span-stars (buf:ptr start:i64 stop:i64):i32
+  (let (p:i64 start
+        n:i32 0)
     (while (< p stop)
-      (when (= (cstr-byte-at buf p) 42) (return 1))
-      (set! p (+ p 1))))
-  (return 0))
+      (when (= (cstr-byte-at buf p) 42) (inc! n))
+      (set! p (+ p 1)))
+    (return n)))
+
+; The base type under the first declarator's `depth` pointers, which c-ptr-to
+; kept, so that `struct S *a, *b;` gives `b` a pointer to `S` too. Null when a
+; level is bare `ptr` (`void *`, an unresolved pointee): that base is lost.
+(defn c-ptr-base (t:ptr depth:i32):ptr
+  (let (acc:ptr t
+        i:i32 0)
+    (while (< i depth)
+      (when (or (= acc null) (= acc (as ptr ty-ptr))) (return null))
+      (let (ty:&Type (unsafe/cast &Type acc))
+        (when (or (!= (ty 'kind) TY-PTR) (= (as ptr (ty 'elem)) null)) (return null))
+        (set! acc (as ptr (ty 'elem))))
+      (inc! i))
+    ; c-ptr-to's char pointees, as the by-value types they stand for.
+    (cond (= acc (as ptr ty-c-char)) (return (as ptr ty-i8))
+          (= acc (as ptr ty-c-uchar)) (return (as ptr ty-ui8))
+          true (return acc))))
 
