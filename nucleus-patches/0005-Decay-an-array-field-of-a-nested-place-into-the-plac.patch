From 0081d2a59e83f9d6aaafff892959194688d2d6f8 Mon Sep 17 00:00:00 2001
From: Zak Wilson <zak.wilson@gmail.com>
Date: Sat, 7 Nov 2026 10:11:58 +0000
Subject: [PATCH] Decay an array field of a nested place into the place, not a
 copy

((B 'init) 'b) loaded `init` into a temporary and decayed the array
there, so luaL_buffinit's buffer pointed at dead stack. A head-position
or `field` read of an array field now takes a storage place's address,
and the receiver checks fall back to place-value-type, which types
(aref p i) on a &T where node-type doesn't; `ref` copied that one too.
Found by the nuc-lua port (ISSUE-023).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CsC8i2S7yJAHSpzRaddMj3
---
 design/progress.md     | 15 +++++++++++++++
 docs/structs-unions.md |  3 ++-
 src/nucleusc.nuc       | 30 +++++++++++++++++++++++++++---
 tests/suite-s21.nuc    | 20 ++++++++++++++++++++
 4 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/design/progress.md b/design/progress.md
index c39c8e0..e8457d5 100644
--- a/design/progress.md
+++ b/design/progress.md
@@ -5725,3 +5725,18 @@ port defines it in an imported file under `(set-ir-prefix "")`.
 
 `lua-imported-file-implements-header` (with `tests/fixtures/lua-impl.h`) and
 `varargs-called-before-its-definition` cover both.
+
+## Lua-port fixes: an array field of a nested place (lua-bugfixes)
+
+Found by the nuc-lua port (its ISSUE-023): `luaL_buffinit` sets `B->b = B->init.b`, and
+`((B 'init) 'b)` decayed to the address of a copy of `init`, so every buffer wrote into a
+dead temporary. nuc-doom ISSUE-040 had fixed this for a binding receiver only.
+
+- `array-field-place-receiver`: when a head-position or `field` read selects an array
+  field of a storage place, the receiver is emitted as the place's address.
+- `receiver-type`: `node-type` leaves `(aref p i)` on a `&T` untyped, which sent
+  `((aref p i) 'in)` to the copy path, in `ref` as well. The receiver checks fall back to
+  `place-value-type`.
+
+`s21-array-field-of-nested-place` covers struct and union members, `field`, and an
+element receiver.
diff --git a/docs/structs-unions.md b/docs/structs-unions.md
index 68c737b..63d8b66 100644
--- a/docs/structs-unions.md
+++ b/docs/structs-unions.md
@@ -195,7 +195,8 @@ via the field GEP with no load — so it is directly indexable:
 Consequently an array field cannot be assigned as a whole (`(set! (r 'cells) …)`
 is refused, as `s.xs = …` is in C); write through the decayed pointer with
 an element place, or copy with `memcpy`. `(ref r 'cells)` gives the same address as
-`(r 'cells)`.
+`(r 'cells)`. So does a nested place: `((o 'in) 'cells)` and `(((aref rows i) 'in) 'cells)`
+decay to the storage inside `o` and `rows`, as `o->in.cells` does in C, never to a copy.
 
 A struct literal fills an array field from an `(array T ...)` literal, in a
 `defvar`'s constant initializer (see
diff --git a/src/nucleusc.nuc b/src/nucleusc.nuc
index bd04980..c2ae613 100644
--- a/src/nucleusc.nuc
+++ b/src/nucleusc.nuc
@@ -7292,6 +7292,19 @@
   (when-some (rv (binding-storage rnode scope line)) (return rv))
   (return (materialize-struct-value v scope line)))
 
+; The same for a nested place, `((o 'in) 'buf)`: an array field decays to the
+; place's storage, not a copy's (nuc-lua ISSUE-023). Null when that isn't the case.
+(defn array-field-place-receiver (recv:?&Node sel:?&Node scope:&Scope line:i32):?&Val
+  (when (or (!= (node-kind recv) NODE-LIST) (not (storage-place? recv scope))) (return null))
+  (let (lit:?&Node (selector-literal-sym sel)
+        t:?&Type (receiver-type recv scope))
+    (when (or (= lit null) (= t null)) (return null))
+    (when (and (!= (t 'kind) TY-STRUCT) (!= (t 'kind) TY-UNION)) (return null))
+    (let (fr:?&FieldRef (struct-field-ref (as ?&StructDef (t 'sdef)) (lit 's)))
+      (when (= fr null) (return null))
+      (when (!= (-> fr (_ 'type) (unsafe/cast &Type _) (_ 'kind)) TY-ARRAY) (return null))
+      (return (emit-place-address (unsafe/cast &Node recv) scope line)))))
+
 (defn pointer-typed? (n:?&Node scope:&Scope):bool
   (if-some (t (node-type n scope)) (return (= (t 'kind) TY-PTR)) (return false)))
 
@@ -7353,6 +7366,12 @@
       (return (node-list2 (node-at n 1) (node-at n 2) (node-line n 0))))
     (return null)))
 
+; A receiver's type for deciding whether it has storage. node-type leaves
+; `(aref p i)` on a `&T` untyped, so `((aref p i) 'f)` would be copied (ISSUE-023).
+(defn receiver-type (n:?&Node scope:&Scope):?&Type
+  (when-some (t (node-type n scope)) (return t))
+  (return (place-value-type n scope)))
+
 (defn emit-lvalue-receiver (rnode:?&Node scope:&Scope what:StrView line:i32):&Val
   (when-some (rv (binding-storage rnode scope line)) (return rv))
   ; `((aref a i) 'f)`: the element's own address, not a copy of it.
@@ -7817,7 +7836,9 @@
 (defn emit-field (call:?&Node scope:&Scope):&Val
   (let (cc:(ptr Node) call)
     (when (!= (node-len cc) 3) (die-at (cc 'line) "field expects (field value selector)"))
-    (let (callee-val:&Val (emit-node (node-at cc 1) scope))
+    (let (callee-val:&Val (if-some (pa (array-field-place-receiver (node-at cc 1) (node-at cc 2) scope (cc 'line)))
+                            pa
+                            (emit-node (node-at cc 1) scope)))
       (when (= (is-member-access-receiver (callee-val 'type)) 0)
         (die-at (cc 'line) "field: operand must be a struct or union, or a pointer to one"))
       (return (emit-field-intrinsic (node-list2 (node-at cc 1) (node-at cc 2) (cc 'line))
@@ -8115,7 +8136,7 @@
 (defn emit-callable-place (x:&Node recv:ptr sel-at:i32 scope:&Scope line:i32):?&Val
   (let (sel:?&Node (node-at (as ptr x) sel-at)
         nargs:i32 (- (node-len (as ptr x)) sel-at)
-        ct:ptr (node-type recv scope)
+        ct:ptr (as ptr (receiver-type recv scope))
         pre:?&Val null)
     (when (= ct null)
       (let (v:&Val (emit-node recv scope))
@@ -12992,7 +13013,7 @@
               (return (emit-binding-address rn scope (node-line (as ptr rn) line)))))
           0))
       (when (= (rn 'kind) NODE-LIST)
-        (let (t:ptr (node-type (as ptr rn) scope))
+        (let (t:ptr (as ptr (receiver-type (as ptr rn) scope)))
           (when (and (!= t null) (or (= ((unsafe/cast &Type t) 'kind) TY-STRUCT)
                                      (= ((unsafe/cast &Type t) 'kind) TY-UNION)))
             (when-some (pa (emit-place-address rn scope line)) (return pa)))))
@@ -15425,6 +15446,9 @@
                     (let (stamped-ty:ptr (parse-type-from-node (as ptr head) (head 'line)))
                       (when (= ((unsafe/cast &Type stamped-ty) 'kind) TY-STRUCT)
                         (return (emit-struct-lit n scope ((unsafe/cast &Type stamped-ty) 'sdef)))))))))))
+        (when (= (node-len nn) 2)
+          (when-some (pa (array-field-place-receiver head (node-at nn 1) scope (nn 'line)))
+            (return (emit-callable-value n scope pa))))
         (return (emit-callable-value n scope (emit-node (as ptr head) scope))))
       (let (h:Symbol (head 's)
             hp:ptr (as ptr head))
diff --git a/tests/suite-s21.nuc b/tests/suite-s21.nuc
index cdf47ec..80f289c 100644
--- a/tests/suite-s21.nuc
+++ b/tests/suite-s21.nuc
@@ -4054,6 +4054,26 @@ int main(void) {
     (drop &out))
   (return (ok)))
 
+; The same through a nested place: `((o 'in) 'b)` decayed into a copy of `in`,
+; so luaL_buffinit's `B->init.b` pointed at a dead temporary (nuc-lua ISSUE-023).
+(deftest s21-array-field-of-nested-place
+  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
+(defstruct In x:i32 b:(array i8 8))
+(defstruct Out n:i64 in:In un:(union d:f64 c:(array i8 8)))
+(defn main ():i32
+  (let (o:&Out (alloca Out)
+        arr:&Out (alloca Out 2))
+    (set! (aref ((o 'in) 'b) 0) 65)
+    (set! (aref (field (o 'un) 'c) 1) 66)
+    (set! (aref (((aref arr 1) 'in) 'b) 2) 67)
+    (printf \"%d %d %d %d\\n\" (aref (ref (o 'in) 'b) 0) (aref (ref (o 'un) 'c) 1)
+            (aref (ref ((aref arr 1) 'in) 'b) 2) (if (= (as ptr ((o 'in) 'b)) (as ptr (ref (o 'in) 'b))) 1 0)))
+  0)
+")))
+    (try (check-golden (string-as-view &out) "65 66 67 1\n"))
+    (drop &out))
+  (return (ok)))
+
 ; With nucleus.error loaded only by `import-ct`, an `err` site called
 ; `err-find-handler`, which the program never defined (nuc-doom ISSUE-039).
 ; Imported for real as well, the handler chain must still be consulted.
